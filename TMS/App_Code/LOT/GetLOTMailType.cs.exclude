public class GetLOTMailType
{
    int mailType = 0;

    public int GetMailType(int createdByID, int PEID, int PMID, int prodMngrID, int amendmentCount)
    {
        try
        {
            mailType = 0;

            if (amendmentCount > 0)
                mailType = GetAmendedMailType(createdByID, PEID, PMID, prodMngrID);
            else
                mailType = GetMailType(createdByID, PEID, PMID, prodMngrID);


            return mailType;
        }
        catch (Exception)
        {
            return 0;
        }
    }

