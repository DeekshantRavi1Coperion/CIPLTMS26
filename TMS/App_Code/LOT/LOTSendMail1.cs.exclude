                                    LOTMainSubitemID = Convert.ToInt32(dtSi4.Rows[0]["LOT_MAIN_SUBITEM_ID"]);
                                    objLOTMailInfoProperties = GetMailInfo(dsMailInfo, LOTMainSubitemID);
                                    CallSendMailFunction(LOTTFID, TFNo, dsMailInfo.Tables[0], dtSi4, objLOTMailInfoProperties, createdByID, remarks, qualityPlanningStatusID, qualityInspID);
