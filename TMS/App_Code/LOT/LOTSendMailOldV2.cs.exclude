            dsMailInfo = objProject.GetJOBMailInfoTwo(LOTTFID, LOTTFSubitemIDs, qaIntlInspFlag);


            dtSi1.Rows.Clear();
            dtSi2.Rows.Clear();
            dtSi3.Rows.Clear();

            if (dsMailInfo.Tables.Count > 0)
            {
                isPlannigMailSent = false;
                isQualityMailSent = false;

                PEID = Convert.ToInt32(dsMailInfo.Tables[0].Rows[0]["PE_ID"]);
                PMID = Convert.ToInt32(dsMailInfo.Tables[0].Rows[0]["PM_ID"]);

                foreach (DataRow d2 in dsMailInfo.Tables[2].Rows)
                {
                    recordNo = Convert.ToInt32(d2["RECORD_NO"]);
                    LOTTFSubitemID = Convert.ToInt32(d2["LOT_TF_SUBITEM_ID"]);

                    if (partialQuantityFlag > 0)
                    {
                        if (partialStatusID == Convert.ToInt32(LOTAllStatusAndTypes.EnumPartialStatus.PartialIntlInspection))
                            currentStatusID = Convert.ToInt32(LOTAllStatusAndTypes.EnumStatus.IntlInspection);

                        else if (partialStatusID == Convert.ToInt32(LOTAllStatusAndTypes.EnumPartialStatus.PartialQAItemAccepted))
                            currentStatusID = Convert.ToInt32(LOTAllStatusAndTypes.EnumStatus.QAItemAccepted);

                        else if (partialStatusID == Convert.ToInt32(LOTAllStatusAndTypes.EnumPartialStatus.PartialQAItemNotAccepted))
                            currentStatusID = Convert.ToInt32(LOTAllStatusAndTypes.EnumStatus.QAItemNotAccepted);

                        else if (partialStatusID == Convert.ToInt32(LOTAllStatusAndTypes.EnumPartialStatus.PartialComplete))
                            currentStatusID = Convert.ToInt32(LOTAllStatusAndTypes.EnumStatus.Complete);
                    }
                    else
                        currentStatusID = Convert.ToInt32(d2["STATUS_ID"]);

                    createdByID = Convert.ToInt32(d2["CREATED_BY_ID"]);
                    approvedByID = Convert.ToInt32(d2["APPROVED_BY_ID"]);
                    amendmentCount = Convert.ToInt32(d2["AMENDMENT_COUNT"]);
                    amendedByID = Convert.ToInt32(d2["AMENDED_BY_ID"]);
                    amendedApprovedByID = Convert.ToInt32(d2["AMENDED_APPROVED_BY_ID"]);

                    foreach (DataRow d3 in dsMailInfo.Tables[3].Select("LOT_MAIN_SUBITEM_ID='" + Convert.ToInt32(d2["LOT_MAIN_SUBITEM_ID"]) + "'"))
                    {
                        prodMngrID = Convert.ToInt32(d3["PRODUCTION_MNGR_ID"]);

                        if (partialQuantityFlag > 0)
                        {
                            if (partialStatusID == Convert.ToInt32(LOTAllStatusAndTypes.EnumPartialStatus.PartialIntlInspection))
                            {
                                currentStatusID = Convert.ToInt32(LOTAllStatusAndTypes.EnumStatus.IntlInspection);
                                nextStatusID = Convert.ToInt32(LOTAllStatusAndTypes.EnumStatus.IntlInspection);
                            }
                            else if (partialStatusID == Convert.ToInt32(LOTAllStatusAndTypes.EnumPartialStatus.PartialQAItemAccepted))
                            {
                                currentStatusID = Convert.ToInt32(LOTAllStatusAndTypes.EnumStatus.QAItemAccepted);
                                nextStatusID = Convert.ToInt32(LOTAllStatusAndTypes.EnumStatus.QAItemAccepted);
                            }
                            else if (partialStatusID == Convert.ToInt32(LOTAllStatusAndTypes.EnumPartialStatus.PartialQAItemNotAccepted))
                            {
                                currentStatusID = Convert.ToInt32(LOTAllStatusAndTypes.EnumStatus.QAItemNotAccepted);
                                nextStatusID = Convert.ToInt32(LOTAllStatusAndTypes.EnumStatus.QAItemNotAccepted);
                            }
                            else if (partialStatusID == Convert.ToInt32(LOTAllStatusAndTypes.EnumPartialStatus.PartialComplete))
                            {
                                currentStatusID = Convert.ToInt32(LOTAllStatusAndTypes.EnumStatus.Complete);
                                nextStatusID = Convert.ToInt32(LOTAllStatusAndTypes.EnumStatus.Complete);
                            }
                        }
                        else
                        {
                            if (amendmentCount > 0)
                                objLOTMailTypeAndStatusProperties = objGetLOTMailTypeAndStatus.GetLOTMailTypeAndStatusValues(createdByID, objGetLOTApproverStatus.GetApproverStatusValue(amendedByID, PEID, PMID, prodMngrID, amendedApprovedByID), amendmentCount, currentStatusID);
                            else
                                objLOTMailTypeAndStatusProperties = objGetLOTMailTypeAndStatus.GetLOTMailTypeAndStatusValues(createdByID, objGetLOTApproverStatus.GetApproverStatusValue(createdByID, PEID, PMID, prodMngrID, approvedByID), amendmentCount, currentStatusID);

                            nextStatusID = objLOTMailTypeAndStatusProperties.NextStatusID;
                        }



