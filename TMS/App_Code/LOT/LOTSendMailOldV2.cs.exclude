                            drs3["SENT_TO_INTL_INSP_BY"] = drsi["SENT_TO_INTL_INSP_BY"];
                            drs3["SENT_TO_INTL_INSP_ON"] = drsi["SENT_TO_INTL_INSP_ON"];
                            drs3["SENT_TO_INTL_INSP_REMARKS"] = drsi["SENT_TO_INTL_INSP_REMARKS"];
                            drs3["QA_INTL_INSP_ACCEPTED_BY_ID"] = drsi["QA_INTL_INSP_ACCEPTED_BY_ID"];
                            drs3["QA_INTL_INSP_ACCEPTED_BY"] = drsi["QA_INTL_INSP_ACCEPTED_BY"];
                            drs3["QA_INTL_INSP_ACCEPTED_ON"] = drsi["QA_INTL_INSP_ACCEPTED_ON"];
                            drs3["QA_INTL_INSP_ACCEPTED_REMARKS"] = drsi["QA_INTL_INSP_ACCEPTED_REMARKS"];
                            drs3["QA_INTL_INSP_NOT_ACCEPTED_BY_ID"] = drsi["QA_INTL_INSP_NOT_ACCEPTED_BY_ID"];
                            drs3["QA_INTL_INSP_NOT_ACCEPTED_BY"] = drsi["QA_INTL_INSP_NOT_ACCEPTED_BY"];
                            drs3["QA_INTL_INSP_NOT_ACCEPTED_ON"] = drsi["QA_INTL_INSP_NOT_ACCEPTED_ON"];
                            drs3["QA_INTL_INSP_NOT_ACCEPTED_REMARKS"] = drsi["QA_INTL_INSP_NOT_ACCEPTED_REMARKS"];
                            drs3["QUALITY_ACCEPTED_BY_ID"] = drsi["QUALITY_ACCEPTED_BY_ID"];
                            drs3["QUALITY_ACCEPTED_BY"] = drsi["QUALITY_ACCEPTED_BY"];
                            drs3["QUALITY_ACCEPTED_ON"] = drsi["QUALITY_ACCEPTED_ON"];
                            drs3["QUALITY_ACCEPTED_REMARKS"] = drsi["QUALITY_ACCEPTED_REMARKS"];
                            drs3["PLANNING_ACCEPTED_BY_ID"] = drsi["PLANNING_ACCEPTED_BY_ID"];
                            drs3["PLANNING_ACCEPTED_BY"] = drsi["PLANNING_ACCEPTED_BY"];
                            drs3["PLANNING_ACCEPTED_ON"] = drsi["PLANNING_ACCEPTED_ON"];
                            drs3["PLANNING_ACCEPTED_REMARKS"] = drsi["PLANNING_ACCEPTED_REMARKS"];
                            drs3["AMENDMENT_COUNT"] = drsi["AMENDMENT_COUNT"];
                            drs3["AMENDMENT_BY_ID"] = drsi["AMENDMENT_BY_ID"];
                            drs3["AMENDMENT_BY"] = drsi["AMENDMENT_BY"];
                            drs3["AMENDMENT_ON"] = drsi["AMENDMENT_ON"];
                            drs3["AMENDMENT_REMARKS"] = drsi["AMENDMENT_REMARKS"];
                            drs3["AMENDED_BY_ID"] = drsi["AMENDED_BY_ID"];
                            drs3["AMENDED_BY"] = drsi["AMENDED_BY"];
                            drs3["AMENDED_ON"] = drsi["AMENDED_ON"];
                            drs3["AMENDED_REMARKS"] = drsi["AMENDED_REMARKS"];
                            drs3["AMENDED_APPROVED_BY_ID"] = drsi["AMENDED_APPROVED_BY_ID"];
                            drs3["AMENDED_APPROVED_BY"] = drsi["AMENDED_APPROVED_BY"];
                            drs3["AMENDED_APPROVED_ON"] = drsi["AMENDED_APPROVED_ON"];
                            drs3["AMENDED_APPROVED_REMARKS"] = drsi["AMENDED_APPROVED_REMARKS"];
                            drs3["AMENDED_ACCEPTED_BY_ID"] = drsi["AMENDED_ACCEPTED_BY_ID"];
                            drs3["AMENDED_ACCEPTED_BY"] = drsi["AMENDED_ACCEPTED_BY"];
                            drs3["AMENDED_ACCEPTED_ON"] = drsi["AMENDED_ACCEPTED_ON"];
                            drs3["AMENDED_ACCEPTED_REMARKS"] = drsi["AMENDED_ACCEPTED_REMARKS"];
                            drs3["AMENDED_QUALITY_ACCEPTED_BY_ID"] = drsi["AMENDED_QUALITY_ACCEPTED_BY_ID"];
                            drs3["AMENDED_QUALITY_ACCEPTED_BY"] = drsi["AMENDED_QUALITY_ACCEPTED_BY"];
                            drs3["AMENDED_QUALITY_ACCEPTED_ON"] = drsi["AMENDED_QUALITY_ACCEPTED_ON"];
                            drs3["AMENDED_QUALITY_ACCEPTED_REMARKS"] = drsi["AMENDED_QUALITY_ACCEPTED_REMARKS"];
                            drs3["AMENDED_PLANNING_ACCEPTED_BY_ID"] = drsi["AMENDED_PLANNING_ACCEPTED_BY_ID"];
                            drs3["AMENDED_PLANNING_ACCEPTED_BY"] = drsi["AMENDED_PLANNING_ACCEPTED_BY"];
                            drs3["AMENDED_PLANNING_ACCEPTED_ON"] = drsi["AMENDED_PLANNING_ACCEPTED_ON"];
                            drs3["AMENDED_PLANNING_ACCEPTED_REMARKS"] = drsi["AMENDED_PLANNING_ACCEPTED_REMARKS"];
                            drs3["COMPLETED_BY_ID"] = drsi["COMPLETED_BY_ID"];
                            drs3["COMPLETED_BY"] = drsi["COMPLETED_BY"];
                            drs3["COMPLETED_ON"] = drsi["COMPLETED_ON"];
                            drs3["COMPLETED_REMARKS"] = drsi["COMPLETED_REMARKS"];

                            #endregion

                            dtSi3.Rows.Add(drs3);
                        }
                    }
                }


                if (dsMailInfo.Tables[8].Rows.Count > 0)
                {
                    foreach (DataRow dr8 in dsMailInfo.Tables[8].Rows)
                    {
                        bcc += Convert.ToString(dr8["EMAIL_ID"]) + ";";
                    }

                    if (!string.IsNullOrEmpty(bcc)) ;
                    bcc = bcc.TrimEnd(';');
                }


                isPlannigMailSent = false;
                isQualityMailSent = false;

                if (dsMailInfo.Tables[9].Rows.Count > 0)
                {
                    dtQuantityDetails = dsMailInfo.Tables[9];
                }
                else dtQuantityDetails = null;

                if (dtSi1.Rows.Count > 0)
                {
                    LOTMainSubitemID = Convert.ToInt32(dtSi1.Rows[0]["LOT_MAIN_SUBITEM_ID"]);
                    objLOTMailInfoProperties = GetMailInfo(dsMailInfo, LOTMainSubitemID);
                    CallSendMailFunction(LOTTFID, TFNo, unitID, dsMailInfo.Tables[0], dtSi1, objLOTMailInfoProperties, createdByID, remarks,
                        qualityPlanningStatusID, 0, editFlag, IRNFileBytes, bcc, dtQuantityDetails, partialStatusID, partialQuantityFlag);
                }

                if (dtSi2.Rows.Count > 0)
                {
                    isPlannigMailSent = false;
                    isQualityMailSent = false;

                    if (qualityPlanningStatusID == 0)
                    {
                        dtSi4.Rows.Clear();

                        foreach (DataRow drdprdmngr in dsMailInfo.Tables[7].Rows)
                        {
                            dtSi4.Rows.Clear();

                            prodMngrID = Convert.ToInt32(drdprdmngr["PRODUCTION_MNGR_ID"]);
                            foreach (DataRow drprdsi in dsMailInfo.Tables[3].Select("PRODUCTION_MNGR_ID='" + prodMngrID + "'"))
                            {
                                LOTMainSubitemID = Convert.ToInt32(drprdsi["LOT_MAIN_SUBITEM_ID"]);
                                foreach (DataRow dracc in dtSi2.Select("PRODUCTION_MNGR_ID=" + prodMngrID + " AND LOT_MAIN_SUBITEM_ID='" + LOTMainSubitemID + "'"))
                                {
                                    DataRow drs4 = dtSi4.NewRow();

                                    #region DTSI4 Rows

                                    drs4["RECORD_NO"] = dracc["RECORD_NO"];
                                    drs4["LOT_TF_SUBITEM_ID"] = dracc["LOT_TF_SUBITEM_ID"];
                                    drs4["STATUS_ID"] = dracc["STATUS_ID"];
                                    if (partialQuantityFlag > 0)
                                    {
                                        drs4["STATUS_ID"] = currentStatusID;
                                    }
                                    drs4["NEXT_STATUS_ID"] = nextStatusID;

                                    drs4["PRODUCTION_ORDER_NO"] = dracc["PRODUCTION_ORDER_NO"];
                                    drs4["EXPECTED_COMPLETION_DATE"] = dracc["EXPECTED_COMPLETION_DATE"];
                                    drs4["SUBITEM_DESC"] = dracc["SUBITEM_DESC"];
                                    drs4["TAG_NO"] = dracc["TAG_NO"];
                                    drs4["LOT_MAIN_SUBITEM_ID"] = dracc["LOT_MAIN_SUBITEM_ID"];
                                    drs4["LOT_MAIN_ITEM"] = dracc["LOT_MAIN_ITEM"];
                                    drs4["DRAWING_NO"] = dracc["DRAWING_NO"];
                                    drs4["REVISION_NO"] = dracc["REVISION_NO"];
                                    drs4["CATEGORY"] = dracc["CATEGORY"];
                                    drs4["QUANTITY"] = dracc["QUANTITY"];
                                    drs4["PRODUCTION_MNGR_ID"] = dracc["PRODUCTION_MNGR_ID"];
                                    drs4["PRODUCTION_MNGR_NAME"] = dracc["PRODUCTION_MNGR_NAME"];
                                    drs4["CREATED_BY_ID"] = dracc["CREATED_BY_ID"];
                                    drs4["CREATED_BY"] = dracc["CREATED_BY"];
                                    drs4["CREATED_ON"] = dracc["CREATED_ON"];
                                    drs4["APPROVED_BY_ID"] = dracc["APPROVED_BY_ID"];
                                    drs4["APPROVED_BY"] = dracc["APPROVED_BY"];
                                    drs4["APPROVED_ON"] = dracc["APPROVED_ON"];
                                    drs4["APPROVED_REMARKS"] = dracc["APPROVED_REMARKS"];
                                    drs4["ACCEPTED_BY_ID"] = dracc["ACCEPTED_BY_ID"];
                                    drs4["ACCEPTED_BY"] = dracc["ACCEPTED_BY"];
                                    drs4["ACCEPTED_ON"] = dracc["ACCEPTED_ON"];
                                    drs4["ACCEPTED_REMARKS"] = dracc["ACCEPTED_REMARKS"];
                                    drs4["SENT_TO_INTL_INSP_BY_ID"] = dracc["SENT_TO_INTL_INSP_BY_ID"];
                                    drs4["SENT_TO_INTL_INSP_BY"] = dracc["SENT_TO_INTL_INSP_BY"];
                                    drs4["SENT_TO_INTL_INSP_ON"] = dracc["SENT_TO_INTL_INSP_ON"];
                                    drs4["SENT_TO_INTL_INSP_REMARKS"] = dracc["SENT_TO_INTL_INSP_REMARKS"];
                                    drs4["QA_INTL_INSP_ACCEPTED_BY_ID"] = dracc["QA_INTL_INSP_ACCEPTED_BY_ID"];
                                    drs4["QA_INTL_INSP_ACCEPTED_BY"] = dracc["QA_INTL_INSP_ACCEPTED_BY"];
                                    drs4["QA_INTL_INSP_ACCEPTED_ON"] = dracc["QA_INTL_INSP_ACCEPTED_ON"];
                                    drs4["QA_INTL_INSP_ACCEPTED_REMARKS"] = dracc["QA_INTL_INSP_ACCEPTED_REMARKS"];
                                    drs4["QA_INTL_INSP_NOT_ACCEPTED_BY_ID"] = dracc["QA_INTL_INSP_NOT_ACCEPTED_BY_ID"];
                                    drs4["QA_INTL_INSP_NOT_ACCEPTED_BY"] = dracc["QA_INTL_INSP_NOT_ACCEPTED_BY"];
                                    drs4["QA_INTL_INSP_NOT_ACCEPTED_ON"] = dracc["QA_INTL_INSP_NOT_ACCEPTED_ON"];
                                    drs4["QA_INTL_INSP_NOT_ACCEPTED_REMARKS"] = dracc["QA_INTL_INSP_NOT_ACCEPTED_REMARKS"];
                                    drs4["QUALITY_ACCEPTED_BY_ID"] = dracc["QUALITY_ACCEPTED_BY_ID"];
                                    drs4["QUALITY_ACCEPTED_BY"] = dracc["QUALITY_ACCEPTED_BY"];
                                    drs4["QUALITY_ACCEPTED_ON"] = dracc["QUALITY_ACCEPTED_ON"];
                                    drs4["QUALITY_ACCEPTED_REMARKS"] = dracc["QUALITY_ACCEPTED_REMARKS"];
                                    drs4["PLANNING_ACCEPTED_BY_ID"] = dracc["PLANNING_ACCEPTED_BY_ID"];
                                    drs4["PLANNING_ACCEPTED_BY"] = dracc["PLANNING_ACCEPTED_BY"];
                                    drs4["PLANNING_ACCEPTED_ON"] = dracc["PLANNING_ACCEPTED_ON"];
                                    drs4["PLANNING_ACCEPTED_REMARKS"] = dracc["PLANNING_ACCEPTED_REMARKS"];
                                    drs4["AMENDMENT_COUNT"] = dracc["AMENDMENT_COUNT"];
                                    drs4["AMENDMENT_BY_ID"] = dracc["AMENDMENT_BY_ID"];
                                    drs4["AMENDMENT_BY"] = dracc["AMENDMENT_BY"];
                                    drs4["AMENDMENT_ON"] = dracc["AMENDMENT_ON"];
                                    drs4["AMENDMENT_REMARKS"] = dracc["AMENDMENT_REMARKS"];
                                    drs4["AMENDED_BY_ID"] = dracc["AMENDED_BY_ID"];
                                    drs4["AMENDED_BY"] = dracc["AMENDED_BY"];
                                    drs4["AMENDED_ON"] = dracc["AMENDED_ON"];
                                    drs4["AMENDED_REMARKS"] = dracc["AMENDED_REMARKS"];
                                    drs4["AMENDED_APPROVED_BY_ID"] = dracc["AMENDED_APPROVED_BY_ID"];
                                    drs4["AMENDED_APPROVED_BY"] = dracc["AMENDED_APPROVED_BY"];
                                    drs4["AMENDED_APPROVED_ON"] = dracc["AMENDED_APPROVED_ON"];
                                    drs4["AMENDED_APPROVED_REMARKS"] = dracc["AMENDED_APPROVED_REMARKS"];
                                    drs4["AMENDED_ACCEPTED_BY_ID"] = dracc["AMENDED_ACCEPTED_BY_ID"];
                                    drs4["AMENDED_ACCEPTED_BY"] = dracc["AMENDED_ACCEPTED_BY"];
                                    drs4["AMENDED_ACCEPTED_ON"] = dracc["AMENDED_ACCEPTED_ON"];
                                    drs4["AMENDED_ACCEPTED_REMARKS"] = dracc["AMENDED_ACCEPTED_REMARKS"];
                                    drs4["AMENDED_QUALITY_ACCEPTED_BY_ID"] = dracc["AMENDED_QUALITY_ACCEPTED_BY_ID"];
                                    drs4["AMENDED_QUALITY_ACCEPTED_BY"] = dracc["AMENDED_QUALITY_ACCEPTED_BY"];
                                    drs4["AMENDED_QUALITY_ACCEPTED_ON"] = dracc["AMENDED_QUALITY_ACCEPTED_ON"];
                                    drs4["AMENDED_QUALITY_ACCEPTED_REMARKS"] = dracc["AMENDED_QUALITY_ACCEPTED_REMARKS"];
                                    drs4["AMENDED_PLANNING_ACCEPTED_BY_ID"] = dracc["AMENDED_PLANNING_ACCEPTED_BY_ID"];
                                    drs4["AMENDED_PLANNING_ACCEPTED_BY"] = dracc["AMENDED_PLANNING_ACCEPTED_BY"];
                                    drs4["AMENDED_PLANNING_ACCEPTED_ON"] = dracc["AMENDED_PLANNING_ACCEPTED_ON"];
                                    drs4["AMENDED_PLANNING_ACCEPTED_REMARKS"] = dracc["AMENDED_PLANNING_ACCEPTED_REMARKS"];
                                    drs4["COMPLETED_BY_ID"] = dracc["COMPLETED_BY_ID"];
                                    drs4["COMPLETED_BY"] = dracc["COMPLETED_BY"];
                                    drs4["COMPLETED_ON"] = dracc["COMPLETED_ON"];
                                    drs4["COMPLETED_REMARKS"] = dracc["COMPLETED_REMARKS"];

                                    #endregion

                                    dtSi4.Rows.Add(drs4);
                                }
                            }

                            if (qualityInspID > 0)
                            {
                                if (dtSi4.Rows.Count > 0)
                                {
                                    LOTMainSubitemID = Convert.ToInt32(dtSi4.Rows[0]["LOT_MAIN_SUBITEM_ID"]);
                                    objLOTMailInfoProperties = GetMailInfo(dsMailInfo, LOTMainSubitemID);
                                    CallSendMailFunction(LOTTFID, TFNo, unitID, dsMailInfo.Tables[0], dtSi4, objLOTMailInfoProperties, createdByID, remarks, qualityPlanningStatusID,
                                        qualityInspID, 0, IRNFileBytes, bcc, dtQuantityDetails, partialStatusID, partialQuantityFlag);
                                }
                            }
                            else
                            {
                                if (dtSi4.Rows.Count > 0)
                                {
                                    LOTMainSubitemID = Convert.ToInt32(dtSi4.Rows[0]["LOT_MAIN_SUBITEM_ID"]);
                                    objLOTMailInfoProperties = GetMailInfo(dsMailInfo, LOTMainSubitemID);
                                    CallSendMailFunction(LOTTFID, TFNo, unitID, dsMailInfo.Tables[0], dtSi4, objLOTMailInfoProperties, createdByID, remarks,
                                                         qualityPlanningStatusID, 0, 0, IRNFileBytes, bcc, dtQuantityDetails, partialStatusID, partialQuantityFlag);
                                }
                            }

                        }
                        if (qualityPlanningStatusID == 0 && qualityInspID == 0)
                        {
                            bool isAllowedToSendPlanningMail = false;

                            objLOTMailInfoProperties = GetMailInfo(dsMailInfo, LOTMainSubitemID);

                            foreach (DataRow dr in dtSi.Rows)
                            {
                                if (Convert.ToInt32(dr["STATUS_ID"]) == Convert.ToInt32(LOTAllStatusAndTypes.EnumStatus.Approved) ||
                                    Convert.ToInt32(dr["STATUS_ID"]) == Convert.ToInt32(LOTAllStatusAndTypes.EnumStatus.AmndApproved))
                                {
                                    isAllowedToSendPlanningMail = true;
                                    break;
                                }
                            }
                            if (isAllowedToSendPlanningMail)
                            {
                                //CallPlanningSendMailFunction(LOTTFID, TFNo, unitID, dsMailInfo.Tables[0], dtSi2, objLOTMailInfoProperties, createdByID, remarks,
                                 //                            Convert.ToInt32(LOTAllStatusAndTypes.EnumQualityAndPlanningStatus.Planning), partialStatusID, partialQuantityFlag);
                            }
                        }
                    }
                    else
                    {
                        isPlannigMailSent = false;
                        isQualityMailSent = false;

                        if (qualityPlanningStatusID == Convert.ToInt32(LOTAllStatusAndTypes.EnumQualityAndPlanningStatus.Planning))
                        {
                            LOTMainSubitemID = Convert.ToInt32(dtSi.Rows[0]["LOT_MAIN_SUBITEM_ID"]);
                            objLOTMailInfoProperties = GetMailInfo(dsMailInfo, LOTMainSubitemID);
                            CallSendMailFunction(LOTTFID, TFNo, unitID, dsMailInfo.Tables[0], dtSi, objLOTMailInfoProperties, createdByID, remarks,
                                                 qualityPlanningStatusID, 0, 0, IRNFileBytes, bcc, dtQuantityDetails, partialStatusID, partialQuantityFlag);

                            isPlannigMailSent = true;

                        }

                        else if (qualityPlanningStatusID == Convert.ToInt32(LOTAllStatusAndTypes.EnumQualityAndPlanningStatus.Quality))
                        {
                            LOTMainSubitemID = Convert.ToInt32(dtSi2.Rows[0]["LOT_MAIN_SUBITEM_ID"]);
                            objLOTMailInfoProperties = GetMailInfo(dsMailInfo, LOTMainSubitemID);
                            CallSendMailFunction(LOTTFID, TFNo, unitID, dsMailInfo.Tables[0], dtSi2, objLOTMailInfoProperties, createdByID, remarks,
                                                 qualityPlanningStatusID, 0, 0, IRNFileBytes, bcc, dtQuantityDetails, partialStatusID, partialQuantityFlag);

                            isQualityMailSent = true;

                        }

                    }
                }


                if (dtSi3.Rows.Count > 0)
                {
                    if (qualityPlanningStatusID == 0)
                    {
                        LOTMainSubitemID = Convert.ToInt32(dtSi3.Rows[0]["LOT_MAIN_SUBITEM_ID"]);
                        objLOTMailInfoProperties = GetMailInfo(dsMailInfo, LOTMainSubitemID);
                        CallSendMailFunction(LOTTFID, TFNo, unitID, dsMailInfo.Tables[0], dtSi3, objLOTMailInfoProperties, createdByID, remarks,
                                             qualityPlanningStatusID, 0, 0, IRNFileBytes, bcc, dtQuantityDetails, partialStatusID, partialQuantityFlag);
                    }
                    else
                    {
                        if (qualityPlanningStatusID == Convert.ToInt32(LOTAllStatusAndTypes.EnumQualityAndPlanningStatus.Planning))
                        {
                            if (isPlannigMailSent == false)
                            {
                                LOTMainSubitemID = Convert.ToInt32(dtSi.Rows[0]["LOT_MAIN_SUBITEM_ID"]);
                                objLOTMailInfoProperties = GetMailInfo(dsMailInfo, LOTMainSubitemID);
                                CallSendMailFunction(LOTTFID, TFNo, unitID, dsMailInfo.Tables[0], dtSi, objLOTMailInfoProperties, createdByID, remarks,
                                                     qualityPlanningStatusID, 0, 0, IRNFileBytes, bcc, dtQuantityDetails, partialStatusID, partialQuantityFlag);

                                isPlannigMailSent = true;
                            }
                        }

                        else if (qualityPlanningStatusID == Convert.ToInt32(LOTAllStatusAndTypes.EnumQualityAndPlanningStatus.Quality))
                        {
                            if (isQualityMailSent == false)
                            {
                                LOTMainSubitemID = Convert.ToInt32(dtSi3.Rows[0]["LOT_MAIN_SUBITEM_ID"]);
                                objLOTMailInfoProperties = GetMailInfo(dsMailInfo, LOTMainSubitemID);
                                CallSendMailFunction(LOTTFID, TFNo, unitID, dsMailInfo.Tables[0], dtSi3, objLOTMailInfoProperties, createdByID, remarks,
                                                     qualityPlanningStatusID, 0, 0, IRNFileBytes, bcc, dtQuantityDetails, partialStatusID, partialQuantityFlag);

                                isQualityMailSent = true;
                            }
                        }
                    }
                }
            }

            return returnVal;
        }

        catch (Exception ex)
        {
            returnVal = 0;
            return returnVal;
        }
    }

    private void CallSendMailFunction(int LOTTFID, string TFNo, int unitID, DataTable dtLOTDetails, DataTable dtSubitems, LOTMailInfoProperties objLOTMailInfoProperties,
        int createdByID, string remarks, int qualityPlanningStatusID, int qualityInspID, int editFlag, byte[] IRNFileBytes, string bcc, DataTable dtQuantityDetails,
        int partialStatusID, int partialQuantityFlag)
    {
        try
        {

            #region Variables

            mailType = 0;
            currentStatusID = 0;

            createdByName = string.Empty;
            createdByEmail = string.Empty;

            amendedByID = 0;
            amendedByName = string.Empty;
            amendedByEmail = string.Empty;

            PEID = 0;
            PEName = string.Empty;
            PEEmail = string.Empty;
            PEUD = string.Empty;
            PEPD = string.Empty;

            PMID = 0;
            PMName = string.Empty;
            PMEmail = string.Empty;
            PMUD = string.Empty;
            PMPD = string.Empty;

            prodMngrID = 0;
            prodMngrName = string.Empty;
            prodMngrEmail = string.Empty;
            prodMngrEmailCC = string.Empty;

            approvedByID = 0;
            approvedByName = string.Empty;
            approvedByEmail = string.Empty;

            acceptedByID = 0;
            acceptedByName = string.Empty;
            acceptedByEmail = string.Empty;

            sendToIntlInspectionByID = 0;
            sendToIntlInspectionByName = string.Empty;
            sendToIntlInspectionByEmail = string.Empty;

            qAIntlInspectionAcceptedByID = 0;
            qAIntlInspectionAcceptedByName = string.Empty;
            qAIntlInspectionAcceptedByEmail = string.Empty;

            qAIntlInspectionNotAcceptedByID = 0;
            qAIntlInspectionNotAcceptedByName = string.Empty;
            qAIntlInspectionNotAcceptedByEmail = string.Empty;


            amendmentCount = 0;

            amendmentByID = 0;
            amendmentByName = string.Empty;
            amendmentByEmail = string.Empty;

            amendedApprovedByID = 0;
            amendedApprovedByName = string.Empty;
            amendedApprovedByEmail = string.Empty;

            amendedAcceptedByID = 0;
            amendedAcceptedByName = string.Empty;
            amendedAcceptedByEmail = string.Empty;

            completedByID = 0;
            completedByName = string.Empty;
            completedByEmail = string.Empty;


            qualityAcceptedByID = 0;
            qualityAcceptedByName = string.Empty;
            qualityAcceptedByEmail = string.Empty;

            planningAcceptedByID = 0;
            planningAcceptedByName = string.Empty;
            planningAcceptedByEmail = string.Empty;

            qualityAmendedAcceptedByID = 0;
            qualityAmendedAcceptedByName = string.Empty;
            qualityAmendedAcceptedByEmail = string.Empty;

            planningAmendedAcceptedByID = 0;
            planningAmendedAcceptedByName = string.Empty;
            planningAmendedAcceptedByEmail = string.Empty;


            urlTxt = string.Empty;
            href = string.Empty;
            link = string.Empty;

            PEApproveHref = string.Empty;
            PEApproveLink = string.Empty;

            //PEAmendmentHref = string.Empty;
            //PEAmendmentLink = string.Empty;

            PMApproveHref = string.Empty;
            PMApproveLink = string.Empty;

            //PMAmendmentHref = string.Empty;
            //PMAmendmentLink = string.Empty;

            fileName = string.Empty;
            body = string.Empty;
            subject = string.Empty;
            from = string.Empty;
            to = string.Empty;
            cc = string.Empty;

            #endregion


            if (objLOTMailInfoProperties != null)
            {
                if (partialQuantityFlag > 0)
                {
                    if (partialStatusID == Convert.ToInt32(LOTAllStatusAndTypes.EnumPartialStatus.PartialIntlInspection))
                        currentStatusID = Convert.ToInt32(LOTAllStatusAndTypes.EnumStatus.IntlInspection);

                    else if (partialStatusID == Convert.ToInt32(LOTAllStatusAndTypes.EnumPartialStatus.PartialQAItemAccepted))
                        currentStatusID = Convert.ToInt32(LOTAllStatusAndTypes.EnumStatus.QAItemAccepted);

                    else if (partialStatusID == Convert.ToInt32(LOTAllStatusAndTypes.EnumPartialStatus.PartialQAItemNotAccepted))
                        currentStatusID = Convert.ToInt32(LOTAllStatusAndTypes.EnumStatus.QAItemNotAccepted);

                    else if (partialStatusID == Convert.ToInt32(LOTAllStatusAndTypes.EnumPartialStatus.PartialComplete))
                        currentStatusID = Convert.ToInt32(LOTAllStatusAndTypes.EnumStatus.Complete);
                }
                else
                {
                    if (Convert.ToInt32(objLOTMailInfoProperties.statusID) > 0)
                        currentStatusID = Convert.ToInt32(objLOTMailInfoProperties.statusID);
                }

