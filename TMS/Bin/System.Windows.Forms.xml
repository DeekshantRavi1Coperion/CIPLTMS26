			<filterpriority>1</filterpriority>
		</member>
		<member name="F:System.Windows.Forms.AccessibleRole.PageTabList">
			<summary>A container of page tab controls.</summary>
			<filterpriority>1</filterpriority>
		</member>
		<member name="F:System.Windows.Forms.AccessibleRole.Pane">
