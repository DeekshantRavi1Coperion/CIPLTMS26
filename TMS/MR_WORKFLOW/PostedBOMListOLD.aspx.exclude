                                <asp:Label ID="lblIsAmendmentMailSent" runat="server" Visible="false" Text='<%# Eval("IS_AMENDMENT_MAIL_SENT") %>' />
                                <asp:Label ID="lblIsProdAmendmentMailSent" runat="server" Visible="false" Text='<%# Eval("IS_PROD_AMENDMENT_MAIL_SENT") %>' />
