                    <td align="right">LOT For:</td>
                    <td>
                        <table style="width: 100%;">
                            <tr>
                                <td style="width: 50%;">
                                    <asp:DropDownList ID="ddlLOTMainItems" runat="server" Width="100%" Height="25px" OnSelectedIndexChanged="ddlLOTMainItems_SelectedIndexChanged" AutoPostBack="true" />
                                </td>
