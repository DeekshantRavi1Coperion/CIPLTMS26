                                                        quantity = Convert.ToInt32(drsi["QA_ITEM_ACCEPTED_QTY"]);
                                                        actedQuantity = Convert.ToInt32(drsi["COMPLETE_QTY"]);
                                                        remainingQuantity = quantity - actedQuantity;

                                                        DataRow drs3 = dtSi3.NewRow();

