            int amendedApprovedByID = 0;


            currentStatusID = 0;
            createdByID = 0;
            approvedByID = 0;
            amendmentCount = 0;
            amendedByID = 0;
            amendedApprovedByID = 0;
            LOTMainSubitemID = 0;

            if (dsSubitems.Tables.Count > 0 && dsSubitems.Tables[0].Rows.Count > 0)
            {
                foreach (DataRow dr1 in dsSubitems.Tables[1].Rows)
                {
                    LOTMainSubitemID = Convert.ToInt32(dr1["LOT_MAIN_SUBITEM_ID"]);

                    foreach (DataRow dr2 in dsSubitems.Tables[0].Select("LOT_MAIN_SUBITEM_ID='" + LOTMainSubitemID + "'"))
                    {
                        currentStatusID = Convert.ToInt32(dr2["STATUS_ID"]);
                        createdByID = Convert.ToInt32(dr2["CREATED_BY"]);
                        approvedByID = Convert.ToInt32(dr2["APPROVED_BY"]);
                        amendmentCount = Convert.ToInt32(dr2["AMENDMENT_COUNT"]);
                        amendedByID = Convert.ToInt32(dr2["AMENDED_BY"]);
                        amendedApprovedByID = Convert.ToInt32(dr2["AMENDED_APPROVED_BY"]);
                        prodMngrID = Convert.ToInt32(dr2["PRODUCTION_MNGR_ID"]);


                        if (amendmentCount > 0)
