                                if (Convert.ToInt32(drsi["NEXT_STATUS_ID"]) == Convert.ToInt32(LOTAllStatusAndTypes.EnumStatus.IntlInspection) ||
                                    Convert.ToInt32(drsi["NEXT_STATUS_ID"]) == Convert.ToInt32(LOTAllStatusAndTypes.EnumStatus.QAItemAccepted) ||
                                    Convert.ToInt32(drsi["NEXT_STATUS_ID"]) == Convert.ToInt32(LOTAllStatusAndTypes.EnumStatus.QAItemNotAccepted) ||
                                    Convert.ToInt32(drsi["NEXT_STATUS_ID"]) == Convert.ToInt32(LOTAllStatusAndTypes.EnumStatus.Complete) ||
                                    Convert.ToInt32(drsi["NEXT_STATUS_ID"]) == Convert.ToInt32(LOTAllStatusAndTypes.EnumStatus.Completed))
                                {
                                    if (Convert.ToInt32(drsi["IS_PART_OF_PRODUCTION_STATUS_REPORT_ID"]) > 0)
                                    {
                                        if (Convert.ToInt32(drsi["PRODUCTION_MNGR_ID"]) == Convert.ToInt32(Session["EMP_RECORD_ID"]))
                                        {
                                            quantity = 0;
                                            actedQuantity = 0;
                                            remainingQuantity = 0;

                                            quantity = Convert.ToInt32(drsi["QUANTITY"]);
                                            actedQuantity = Convert.ToInt32(drsi["INTERNAL_INSPECTION_QTY"]) - Convert.ToInt32(drsi["QA_ITEM_NOT_ACCEPTED_QTY"]);
                                            remainingQuantity = quantity - actedQuantity;

                                            DataRow drs3 = dtSi3.NewRow();

                                            #region DTSI3 Rows

                                            drs3["SR_NO"] = drsi["SR_NO"];
                                            drs3["LOT_TF_SUBITEM_ID"] = drsi["LOT_TF_SUBITEM_ID"];


