                                                        //drs3["ACTED_QUANTITY"] = drsi["COMPLETE_QTY"];
                                                        //drs3["REMAINING_QUANTITY"] = Convert.ToInt32(drsi["QUANTITY"]) - Convert.ToInt32(drsi["COMPLETE_QTY"]);


                                                        //drs3["QUANTITY"] = Convert.ToInt32(drsi["QUANTITY"]) - Convert.ToInt32(drsi["INTERNAL_INSPECTION_QTY"]) - Convert.ToInt32(drsi["QA_ITEM_ACCEPTED_QTY"]);
                                                        //drs3["ACTED_QUANTITY"] = drsi["COMPLETE_QTY"];
                                                        //drs3["REMAINING_QUANTITY"] = Convert.ToInt32(drsi["QUANTITY"]) - Convert.ToInt32(drsi["INTERNAL_INSPECTION_QTY"]) - Convert.ToInt32(drsi["QA_ITEM_ACCEPTED_QTY"]) - Convert.ToInt32(drsi["COMPLETE_QTY"]);

                                                        drs3["TOTAL_QUANTITY"] = drsi["TOTAL_QUANTITY"];
                                                        drs3["QUANTITY"] = quantity;
