                                                        drs3["COMPLETE_QTY"] = drsi["COMPLETE_QTY"];

                                                        drs3["SI_ATTACHMENT1_NAME"] = drsi["SI_ATTACHMENT1_NAME"];
                                                        drs3["SI_ATTACHMENT2_NAME"] = drsi["SI_ATTACHMENT2_NAME"];
                                                        drs3["SI_ATTACHMENT3_NAME"] = drsi["SI_ATTACHMENT3_NAME"];
                                                        drs3["SI_ATTACHMENT4_NAME"] = drsi["SI_ATTACHMENT4_NAME"];
                                                        drs3["IRN_ATTACHMENT_NAME"] = drsi["IRN_ATTACHMENT_NAME"];



