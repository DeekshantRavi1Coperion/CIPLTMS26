                        }
                        Session["dtSubitems"] = dsSubitems.Tables[0];
                        gvSubitemsSI.DataSource = dsSubitems.Tables[0];
                        gvSubitemsSI.DataBind();
                    }
                    else
                    {
                        Session["dtSubitems"] = null;
                        gvSubitemsSI.DataSource = null;
                        gvSubitemsSI.DataBind();
                    }
