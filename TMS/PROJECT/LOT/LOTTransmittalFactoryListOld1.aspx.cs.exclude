                                                }
                                            }
                                        }


                                        string[] strAccepters = null;

                                        if (!string.IsNullOrEmpty(accepterIDs))
                                            accepterIDs = accepterIDs.TrimEnd(',');

                                        if (!string.IsNullOrEmpty(accepterIDs))
                                        {
                                            strAccepters = accepterIDs.Split(',');
                                            strAccepters = strAccepters.Distinct().ToArray();
