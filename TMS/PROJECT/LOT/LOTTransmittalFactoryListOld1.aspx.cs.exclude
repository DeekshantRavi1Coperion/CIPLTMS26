                                                        drs3["AMENDED_QUALITY_ACCEPTED_BY"] = drsi["AMENDED_QUALITY_ACCEPTED_BY"];
                                                        drs3["AMENDED_PLANNING_ACCEPTED_BY"] = drsi["AMENDED_PLANNING_ACCEPTED_BY"];
                                                        drs3["PRODUCTION_MNGR_ID"] = drsi["PRODUCTION_MNGR_ID"];
                                                        drs3["IS_PART_OF_PRODUCTION_STATUS_REPORT_ID"] = drsi["IS_PART_OF_PRODUCTION_STATUS_REPORT_ID"];

                                                        drs3["INTERNAL_INSPECTION_QTY"] = drsi["INTERNAL_INSPECTION_QTY"];
                                                        drs3["QA_ITEM_ACCEPTED_QTY"] = drsi["QA_ITEM_ACCEPTED_QTY"];
