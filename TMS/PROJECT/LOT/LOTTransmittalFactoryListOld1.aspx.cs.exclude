                                        Convert.ToInt32(drsi["NEXT_STATUS_ID"]) == Convert.ToInt32(LOTAllStatusAndTypes.EnumStatus.QAItemNotAccepted) ||
                                        Convert.ToInt32(drsi["NEXT_STATUS_ID"]) == Convert.ToInt32(LOTAllStatusAndTypes.EnumStatus.Complete) ||
                                        Convert.ToInt32(drsi["NEXT_STATUS_ID"]) == Convert.ToInt32(LOTAllStatusAndTypes.EnumStatus.Completed))
                                    {
                                        if (Convert.ToInt32(drsi["IS_PART_OF_PRODUCTION_STATUS_REPORT_ID"]) > 0)
                                        {
                                            string accepterIDs = string.Empty;
