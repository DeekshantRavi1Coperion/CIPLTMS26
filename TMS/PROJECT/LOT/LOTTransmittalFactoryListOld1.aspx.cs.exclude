                                                        //drs3["STATUS_ID"] = drsi["STATUS_ID"];
                                                        //drs3["NEXT_STATUS_ID"] = drsi["NEXT_STATUS_ID"];


                                                        //if (Convert.ToInt32(drsi["QUANTITY"]) > Convert.ToInt32(drsi["COMPLETE_QTY"]))
                                                        //{
                                                        //    drs3["STATUS_ID"] = Convert.ToInt32(LOTAllStatusAndTypes.EnumStatus.QAItemAccepted);
                                                        //    drs3["NEXT_STATUS_ID"] = Convert.ToInt32(LOTAllStatusAndTypes.EnumStatus.Complete);
                                                        //}
                                                        //else
                                                        //{
                                                        //    drs3["STATUS_ID"] = drsi["STATUS_ID"];
                                                        //    drs3["NEXT_STATUS_ID"] = drsi["NEXT_STATUS_ID"];
                                                        //}


                                                        //if (Convert.ToInt32(drsi["NEXT_STATUS_ID"]) == Convert.ToInt32(LOTAllStatusAndTypes.EnumStatus.Completed))
                                                        //{
                                                        //    drs3["STATUS_ID"] = drsi["STATUS_ID"];
                                                        //    drs3["NEXT_STATUS_ID"] = drsi["NEXT_STATUS_ID"];
                                                        //}

                                                        //else if (Convert.ToInt32(drsi["NEXT_STATUS_ID"]) == Convert.ToInt32(LOTAllStatusAndTypes.EnumStatus.Complete))
                                                        //{
                                                        //    drs3["STATUS_ID"] = Convert.ToInt32(LOTAllStatusAndTypes.EnumStatus.Complete);
                                                        //    drs3["NEXT_STATUS_ID"] = Convert.ToInt32(LOTAllStatusAndTypes.EnumStatus.Completed);
                                                        //}


