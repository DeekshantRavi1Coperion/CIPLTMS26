                                        //if (acceptedByID == 0)
                                        //{
                                        //    btnApproveLOT.Visible = true;
                                        //    btnApproveLOT.Text = "Accept LOT";
                                        //    btnApproveLOT.ToolTip = "Accept LOT Transmittal to Factory";
                                        //}
                                        //btnApprove.Visible = true;
                                        //btnApprove.Text = "Accept Item(s)";
