    <script type="text/javascript">

        function ValidateAll() {
            var check = true;

            if (ValidateCustName()) {
                check = false;
            }

            if (ValidateCustCode()) {
                check = false;
            }

            if (ValidateJobNo()) {
                check = false;
            }


            if (ValidateTFNo()) {
                check = false;
            }

            if (ValidatePONo()) {
                check = false;
            }

            if (ValidateItemName()) {
                check = false;
            }

            if (check) {
                if (confirm("Would you like to save LOT?")) {
                    document.getElementById('<%=hdConfirmValue.ClientID %>').value = "1";
                    return true;
                }
                else {
                    document.getElementById('<%=hdConfirmValue.ClientID %>').value = "0";
                    return false;
