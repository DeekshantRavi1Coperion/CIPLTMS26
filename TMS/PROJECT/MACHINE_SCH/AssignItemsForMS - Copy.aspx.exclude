                            <%--<asp:HiddenField ID="hdLOTTFSubitemDrawing1" runat="server" />
                        <asp:HiddenField ID="hdLOTTFSubitemDrawing2" runat="server" />--%>

                            <asp:Label runat="server" ID="lblLOTNo" Visible="false" />
                            <%--<asp:Label runat="server" ID="lblLOTTFSubitemID" Visible="true" Text="0" />--%>
                            <asp:Label runat="server" ID="lblSIDrawing1" Visible="false" />
                            <asp:Label runat="server" ID="lblSIDrawing2" Visible="false" />

                            <asp:TextBox ID="txtEquipmentToA" runat="server" Width="100%" Enabled="false" onblur="return ValidateEquipment();" />
                        </td>
