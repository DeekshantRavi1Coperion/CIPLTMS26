    protected void ddlMachine_SelectedIndexChanged(object sender, EventArgs e)
    {
        if (gvMachineDetail.Rows.Count > 0)
        {
            GridViewRow gvr = (GridViewRow)(((Control)sender).NamingContainer);
            DropDownList ddlMachine = (DropDownList)gvr.FindControl("ddlMachine");
            DropDownList ddlActivity = (DropDownList)gvr.FindControl("ddlActivity");

            if (ddlMachine.SelectedIndex > 0)
            {
                dsActivity = objMS.GetMachineActivity(Convert.ToInt32(ddlMachine.SelectedValue));
                if (dsActivity.Tables.Count > 0 && dsActivity.Tables[0].Rows.Count > 0)
                {
                    ddlActivity.DataSource = dsActivity.Tables[0];
                    ddlActivity.DataBind();
                    ddlActivity.DataTextField = "ACTIVITY_NAME";
                    ddlActivity.DataValueField = "ACTIVITY_FID";
                    ddlActivity.Items.Insert(0, "Select");
                    ddlActivity.SelectedIndex = 0;
                }
                else
                {
                    ddlActivity.Items.Clear();
                    ddlActivity.Items.Insert(0, "Select");
                    ddlActivity.SelectedIndex = 0;
                }
            }
            else
            {
                ddlActivity.Items.Clear();
                ddlActivity.Items.Insert(0, "Select");
                ddlActivity.SelectedIndex = 0;
            }

        }
    }

    protected void gvMachineDetail_RowDataBound(object sender, GridViewRowEventArgs e)
    {
        try
        {
            int hrs = 0;
            int mns = 0;

            if (e.Row.RowType == DataControlRowType.DataRow)
            {
                DropDownList ddlUnit = (DropDownList)e.Row.FindControl("ddlUnit");
                DropDownList ddlMachine = (DropDownList)e.Row.FindControl("ddlMachine");
                DropDownList ddlType = (DropDownList)e.Row.FindControl("ddlType");
                DropDownList ddlActivity = (DropDownList)e.Row.FindControl("ddlActivity");

                TextBox txtJOBNo = (TextBox)e.Row.FindControl("txtJOBNo");
                TextBox txtDrawingNo = (TextBox)e.Row.FindControl("txtDrawingNo");
                TextBox txtEquipment = (TextBox)e.Row.FindControl("txtEquipment");
                TextBox txtItemDesc = (TextBox)e.Row.FindControl("txtItemDesc");
                TextBox txtQuantity = (TextBox)e.Row.FindControl("txtQuantity");
                TextBox txtDateofReceiptofMaterial = (TextBox)e.Row.FindControl("txtDateofReceiptofMaterial");
                TextBox txtEDofCompbyPlanning = (TextBox)e.Row.FindControl("txtEDofCompbyPlanning");
                TextBox txtEDofCompbyProduction = (TextBox)e.Row.FindControl("txtEDofCompbyProduction");

                TextBox txtScheduledFrom = (TextBox)e.Row.FindControl("txtScheduledFrom");
                TextBox txtScheduledTo = (TextBox)e.Row.FindControl("txtScheduledTo");
                TextBox txtActualDateofComp = (TextBox)e.Row.FindControl("txtActualDateofComp");
                TextBox txtRemarks = (TextBox)e.Row.FindControl("txtRemarks");

                txtDateofReceiptofMaterial.Text = DateTime.Now.ToString("dd-MMM-yyyy");
                txtEDofCompbyPlanning.Text = DateTime.Now.ToString("dd-MMM-yyyy");
                txtEDofCompbyProduction.Text = DateTime.Now.ToString("dd-MMM-yyyy");
                txtScheduledFrom.Text = DateTime.Now.ToString("dd-MMM-yyyy");
                txtScheduledTo.Text = DateTime.Now.ToString("dd-MMM-yyyy");
                txtActualDateofComp.Text = DateTime.Now.ToString("dd-MMM-yyyy");


                Session["dtUnit"] = null;
                Session["dtMachine"] = null;
                Session["dtType"] = null;

                DataTable dtUnit = new DataTable();
                DataTable dtMachine = new DataTable();
                DataTable dtType = new DataTable();

                if (Session["dtUnit"] != null)
                    dtUnit = (DataTable)Session["dtUnit"];
                else
                {
                    GetUnitData();
                    dtUnit = (DataTable)Session["dtUnit"];
                }

                if (Session["dtMachine"] != null)
                    dtMachine = (DataTable)Session["dtMachine"];
                else
                {
                    GetMachineData();
                    dtMachine = (DataTable)Session["dtMachine"];
                }

                if (Session["dtType"] != null)
                    dtType = (DataTable)Session["dtType"];
                else
                {
                    GetTypeData();
                    dtType = (DataTable)Session["dtType"];
                }

                if (dtUnit.Rows.Count > 0)
                {
                    ddlUnit.DataSource = dtUnit;
                    ddlUnit.DataTextField = "UNIT_NAME";
                    ddlUnit.DataValueField = "UNIT_ID";
                    ddlUnit.DataBind();
                    ddlUnit.Items.Insert(0, "Select");
                    ddlUnit.SelectedIndex = 0;
                }
                else
                {
                    ddlUnit.Items.Clear();
                    ddlUnit.Items.Insert(0, "Select");
                    ddlUnit.SelectedIndex = 0;
                }

                if (dtMachine.Rows.Count > 0)
                {
                    ddlMachine.DataSource = dtMachine;
                    ddlMachine.DataTextField = "MACHINE_NAME";
                    ddlMachine.DataValueField = "MACHINE_PID";
                    ddlMachine.DataBind();
                    ddlMachine.Items.Insert(0, "Select");
                    ddlMachine.SelectedIndex = 0;
                }
                else
                {
                    ddlMachine.Items.Clear();
                    ddlMachine.Items.Insert(0, "Select");
                    ddlMachine.SelectedIndex = 0;
                }


                if (dtType.Rows.Count > 0)
                {
                    ddlType.DataSource = dtType;
                    ddlType.DataTextField = "TYPE_NAME";
                    ddlType.DataValueField = "TYPE_PID";
                    ddlType.DataBind();
                    ddlType.Items.Insert(0, "Select");
                    ddlType.SelectedIndex = 0;
                }
                else
                {
                    ddlType.Items.Clear();
                    ddlType.Items.Insert(0, "Select");
                    ddlType.SelectedIndex = 0;
                }


                ddlActivity.Items.Clear();
                ddlActivity.Items.Insert(0, "Select");
                ddlActivity.SelectedIndex = 0;
            }

        }
        catch (Exception ex)
        {
            ExceptionMessage(ex.ToString());
            return;
        }
    }

