    private void BindFirstRowInList()
    {
        try
        {
            DataTable dtTemp = new DataTable();

            dtTemp.Columns.Add("UNIT_FID", typeof(int));
            dtTemp.Columns.Add("MACHINE_FID", typeof(int));
            dtTemp.Columns.Add("SCHEDULED_TYPE_FID", typeof(int));
            dtTemp.Columns.Add("JOB_NO", typeof(string));
            dtTemp.Columns.Add("DRAWING_NO", typeof(string));
            dtTemp.Columns.Add("EQUIPMENT", typeof(string));
            dtTemp.Columns.Add("ITEM_DESCRIPTION", typeof(string));
            dtTemp.Columns.Add("QUANTITY", typeof(int));
            dtTemp.Columns.Add("DATE_OF_RECEIPT_OF_MATERIAL", typeof(string));
            dtTemp.Columns.Add("ED_OF_COMP_BY_PLANNING", typeof(string));
            dtTemp.Columns.Add("ED_OF_COMP_BY_PRODUCTION", typeof(string));
            dtTemp.Columns.Add("ACTIVITY_FID", typeof(int));
            dtTemp.Columns.Add("SCHEDULED_FROM", typeof(string));
            dtTemp.Columns.Add("SCHEDULED_TO", typeof(string));
            dtTemp.Columns.Add("ACTUAL_COMP_DATE", typeof(string));
            dtTemp.Columns.Add("REMARKS", typeof(string));

            

            if (Session["dtTemp"] != null)
            {
                DataTable dtNew = new DataTable();
                dtNew = dtTemp.Copy();
                dtNew = (DataTable)Session["dtTemp"];

                DataRow dr0 = dtNew.NewRow();
                dr0["UNIT_FID"] = 0;
                dr0["MACHINE_FID"] = 0;
                dr0["SCHEDULED_TYPE_FID"] = 0;
                dr0["JOB_NO"] = string.Empty;
                dr0["DRAWING_NO"] = string.Empty;
                dr0["EQUIPMENT"] = string.Empty;
                dr0["ITEM_DESCRIPTION"] = string.Empty;
                dr0["QUANTITY"] = 0;
                dr0["DATE_OF_RECEIPT_OF_MATERIAL"] = string.Empty;
                dr0["ED_OF_COMP_BY_PLANNING"] = string.Empty;
                dr0["ED_OF_COMP_BY_PRODUCTION"] = string.Empty;
                dr0["ACTIVITY_FID"] = 0;
                dr0["SCHEDULED_FROM"] = string.Empty;
                dr0["SCHEDULED_TO"] = string.Empty;
                dr0["ACTUAL_COMP_DATE"] = string.Empty;
                dr0["REMARKS"] = string.Empty;

                dtNew.Rows.Add(dr0);
                Session["dtTemp"] = dtNew;
                gvMachineDetail.DataSource = dtNew;
                gvMachineDetail.DataBind();
            }
            else
            {
                DataRow dr0 = dtTemp.NewRow();
                dr0["UNIT_FID"] = 0;
                dr0["MACHINE_FID"] = 0;
                dr0["SCHEDULED_TYPE_FID"] = 0;
                dr0["JOB_NO"] = string.Empty;
                dr0["DRAWING_NO"] = string.Empty;
                dr0["EQUIPMENT"] = string.Empty;
                dr0["ITEM_DESCRIPTION"] = string.Empty;
                dr0["QUANTITY"] = 0;
                dr0["DATE_OF_RECEIPT_OF_MATERIAL"] = string.Empty;
                dr0["ED_OF_COMP_BY_PLANNING"] = string.Empty;
                dr0["ED_OF_COMP_BY_PRODUCTION"] = string.Empty;
                dr0["ACTIVITY_FID"] = 0;
                dr0["SCHEDULED_FROM"] = string.Empty;
                dr0["SCHEDULED_TO"] = string.Empty;
                dr0["ACTUAL_COMP_DATE"] = string.Empty;
                dr0["REMARKS"] = string.Empty;

                dtTemp.Rows.Add(dr0);
                Session["dtTemp"] = dtTemp;
                gvMachineDetail.DataSource = dtTemp;
                gvMachineDetail.DataBind();
            }
        }
        catch (Exception ex)
        {
            ExceptionMessage(ex.ToString());
            return;
        }
    }

