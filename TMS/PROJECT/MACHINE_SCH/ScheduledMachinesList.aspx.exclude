                                    Text='<%# Eval("DRAWING_NO") %>'
                                    ToolTip='<%# Eval("DRAWING_NO") %>' />
                            </ItemTemplate>
                        </asp:TemplateField>

                        <asp:TemplateField HeaderText="Equipment">
