    /// <summary>
    /// RowDataBound
    /// </summary>
    /// <param name="sender"></param>
    /// <param name="e"></param>

    protected void gvWorkerTimesheetList_RowDataBound(object sender, GridViewRowEventArgs e)
    {
        try
        {
            int hrs = 0;
            int mns = 0;

            for (int i = 0; i < e.Row.Cells.Count; i++)
            {
                e.Row.Cells[i].Attributes.Add("style", "white-space:nowrap;");
            }

            if (e.Row.RowType == DataControlRowType.DataRow)
            {
                Label lblPunchMissed = (Label)e.Row.FindControl("lblPunchMissed");

                Label lblSerialNo = (Label)e.Row.FindControl("lblSerialNo");
                Label lblEmpCode = (Label)e.Row.FindControl("lblEmpCode");

                Label lblMainRecordFlag = (Label)e.Row.FindControl("lblMainRecordFlag");
                Label lblRecordID = (Label)e.Row.FindControl("lblRecordID");
                ImageButton imgBtnAddNewRecord = (ImageButton)e.Row.FindControl("imgBtnAddNewRecord");
                TextBox txtWorkingHours = (TextBox)e.Row.FindControl("txtWorkingHours");

                //DropDownList ddlOrderType = (DropDownList)e.Row.FindControl("ddlOrderType");

                DropDownList ddlJOBNos = (DropDownList)e.Row.FindControl("ddlJOBNo");
                DropDownList ddlProductionOrderNo = (DropDownList)e.Row.FindControl("ddlProductionOrderNo");
                DropDownList ddlEquipment = (DropDownList)e.Row.FindControl("ddlEquipment");
                DropDownList ddlProductionOrderItemCode = (DropDownList)e.Row.FindControl("ddlProductionOrderItemCode");
                DropDownList ddlItemName = (DropDownList)e.Row.FindControl("ddlItemName");
                DropDownList ddlTagNo = (DropDownList)e.Row.FindControl("ddlTagNo");
                DropDownList ddlActivity = (DropDownList)e.Row.FindControl("ddlActivity");

                Label lblEquipment = (Label)e.Row.FindControl("lblEquipment");
                Label lblProductionOrderNo = (Label)e.Row.FindControl("lblProductionOrderNo");
                Label lblProductionOrderItemCode = (Label)e.Row.FindControl("lblProductionOrderItemCode");
                Label lblItemName = (Label)e.Row.FindControl("lblItemName");
                Label lblTagNo = (Label)e.Row.FindControl("lblTagNo");



                TextBox txtJOBNo = (TextBox)e.Row.FindControl("txtJOBNo");
                TextBox txtItemName = (TextBox)e.Row.FindControl("txtItemName");



                //TextBox txtActivityMatrix = (TextBox)e.Row.FindControl("txtActivityMatrix");

                TextBox txtBalTimesheetHours = (TextBox)e.Row.FindControl("txtBalTimesheetHours");
                TextBox txtAdjustedWorkingHours = (TextBox)e.Row.FindControl("txtAdjustedWorkingHours");
                Label lblAdjustedWorkingHours = (Label)e.Row.FindControl("lblAdjustedWorkingHours");

                TextBox txtRemarks = (TextBox)e.Row.FindControl("txtRemarks");

                DropDownList ddlHours = (DropDownList)e.Row.FindControl("ddlHours");
                DropDownList ddlMins = (DropDownList)e.Row.FindControl("ddlMins");

                ImageButton imgBtnRemoveRecord = (ImageButton)e.Row.FindControl("imgBtnRemoveRecord");


                imgBtnRemoveRecord.Visible = false;



                DataTable dtJOBNo = (DataTable)Session["dtJOBNo"];
                DataTable dtEquipment = (DataTable)Session["dtEquipment"];
                DataTable dtProductionOrderNo = (DataTable)Session["dtProductionOrderNo"];
                DataTable dtProductionOrderItemCode = (DataTable)Session["dtProductionOrderItemCode"];
                DataTable dtItemName = (DataTable)Session["dtItemName"];
                DataTable dtTagNo = (DataTable)Session["dtTagNo"];

                DataTable dtActivity = new DataTable();
                if (Session["dtActivity"] != null)
                    dtActivity = (DataTable)Session["dtActivity"];
                else
                {
                    GetActivity();
                    dtActivity = (DataTable)Session["dtActivity"];
                }

                DataTable dtChanged = (DataTable)Session["dtChanged"];


                if (dtJOBNo.Rows.Count > 0)
                {
                    ddlJOBNos.DataSource = dtJOBNo;
                    ddlJOBNos.DataTextField = "JOB_NO";
                    ddlJOBNos.DataValueField = "JOB_NO";
                    ddlJOBNos.DataBind();
                    ddlJOBNos.Items.Insert(0, "SELECT");

                    foreach (DataRow dr in dtChanged.Select("SERIAL_NO='" + Convert.ToString(lblSerialNo.Text) + "' AND EMPLOYEE_CODE='" + Convert.ToString(lblEmpCode.Text) + "'"))
                    {
                        if (!string.IsNullOrEmpty(Convert.ToString(dr["JOB_NO"])))
                        {
                            ddlJOBNos.SelectedValue = Convert.ToString(dr["JOB_NO"]);
                        }
                        else
                        {
                            ddlJOBNos.SelectedValue = Convert.ToString(ddlJOBNo.SelectedValue);
                        }
                    }
                }

                int jobNoSI = 0;
                int equipmentSI = 0;
                int productionOrderNoSI = 0;

                string jobNoSV = string.Empty;
                string equipmentSV = string.Empty;
                string productionOrderNoSV = string.Empty;

                jobNoSI = Convert.ToInt32(ddlJOBNos.SelectedIndex);
                if (jobNoSI > 0)
                    jobNoSV = Convert.ToString(ddlJOBNos.SelectedValue);


                //Binding of Equipment
                if (jobNoSI > 0)
                {
                    DataTable dtEquipmentNew = new DataTable();
                    dtEquipmentNew = dtEquipment.Copy();
                    dtEquipmentNew.Rows.Clear();

                    foreach (DataRow dr1 in dtEquipment.Select("JOB_NO='" + jobNoSV + "'"))
                    {
                        DataRow drn = dtEquipmentNew.NewRow();
                        drn["JOB_NO"] = Convert.ToString(dr1["JOB_NO"]);
                        drn["EQUIPMENT"] = Convert.ToString(dr1["EQUIPMENT"]);
                        dtEquipmentNew.Rows.Add(drn);
                    }

                    if (dtEquipmentNew != null && dtEquipmentNew.Rows.Count > 0)
                    {
                        ddlEquipment.DataSource = dtEquipmentNew;
                        ddlEquipment.DataTextField = "EQUIPMENT";
                        ddlEquipment.DataValueField = "EQUIPMENT";
                        ddlEquipment.DataBind();
                        ddlEquipment.Items.Insert(0, "SELECT");

                        if (!string.IsNullOrEmpty(Convert.ToString(lblEquipment.Text)))
                        {
                            ddlEquipment.SelectedValue = Convert.ToString(lblEquipment.Text);
                        }
                    }
                }
                else
                {
                    //ddlEquipment.Items.Clear();
                    ddlEquipment.Items.Insert(0, "SELECT");
                    ddlEquipment.SelectedIndex = 0;
                }


                equipmentSI = Convert.ToInt32(ddlEquipment.SelectedIndex);
                if (equipmentSI > 0)
                    equipmentSV = Convert.ToString(ddlEquipment.SelectedValue);

                //Binding of Production Order No
                if (jobNoSI > 0 && equipmentSI > 0)
                {
                    DataTable dtProductionOrderNoNew = new DataTable();
                    dtProductionOrderNoNew = dtProductionOrderNo.Copy();
                    dtProductionOrderNoNew.Rows.Clear();

                    foreach (DataRow dr1 in dtProductionOrderNo.Select("JOB_NO='" + jobNoSV + "'"))
                    {
                        DataRow drn = dtProductionOrderNoNew.NewRow();
                        drn["JOB_NO"] = Convert.ToString(dr1["JOB_NO"]);
                        drn["PRODUCTION_ORDER_NO"] = Convert.ToString(dr1["PRODUCTION_ORDER_NO"]);
                        dtProductionOrderNoNew.Rows.Add(drn);
                    }

                    if (dtProductionOrderNoNew != null && dtProductionOrderNoNew.Rows.Count > 0)
                    {
                        ddlProductionOrderNo.DataSource = dtProductionOrderNoNew;
                        ddlProductionOrderNo.DataTextField = "PRODUCTION_ORDER_NO";
                        ddlProductionOrderNo.DataValueField = "PRODUCTION_ORDER_NO";
                        ddlProductionOrderNo.DataBind();
                        ddlProductionOrderNo.Items.Insert(0, "SELECT");

                        if (!string.IsNullOrEmpty(Convert.ToString(lblProductionOrderNo.Text)))
                        {
                            ddlProductionOrderNo.SelectedValue = Convert.ToString(lblProductionOrderNo.Text);
                        }
                    }
                }
                else
                {
                    //ddlProductionOrderNo.Items.Clear();
                    ddlProductionOrderNo.Items.Insert(0, "SELECT");
                    ddlProductionOrderNo.SelectedIndex = 0;
                }


                productionOrderNoSI = Convert.ToInt32(ddlProductionOrderNo.SelectedIndex);
                if (productionOrderNoSI > 0)
                    productionOrderNoSV = Convert.ToString(ddlProductionOrderNo.SelectedValue);

                //Binding of Production Order Item Code
                if (jobNoSI > 0 && productionOrderNoSI > 0)
                {
                    DataTable dtProductionOrderItemCodeNew = new DataTable();
                    dtProductionOrderItemCodeNew = dtProductionOrderItemCode.Copy();
                    dtProductionOrderItemCodeNew.Rows.Clear();

                    foreach (DataRow dr1 in dtProductionOrderItemCode.Select("JOB_NO='" + jobNoSV + "' AND PRODUCTION_ORDER_NO='" + productionOrderNoSV + "'"))
                    {
                        DataRow drn = dtProductionOrderItemCodeNew.NewRow();
                        drn["JOB_NO"] = Convert.ToString(dr1["JOB_NO"]);
                        drn["PRODUCTION_ORDER_NO"] = Convert.ToString(dr1["PRODUCTION_ORDER_NO"]);
                        drn["SUBITEM_DESC"] = Convert.ToString(dr1["SUBITEM_DESC"]);
                        dtProductionOrderItemCodeNew.Rows.Add(drn);
                    }

                    if (dtProductionOrderItemCodeNew != null && dtProductionOrderItemCodeNew.Rows.Count > 0)
                    {
                        ddlProductionOrderItemCode.DataSource = dtProductionOrderItemCodeNew;
                        ddlProductionOrderItemCode.DataTextField = "SUBITEM_DESC";
                        ddlProductionOrderItemCode.DataValueField = "SUBITEM_DESC";
                        ddlProductionOrderItemCode.DataBind();
                        ddlProductionOrderItemCode.Items.Insert(0, "SELECT");
                        ddlProductionOrderItemCode.SelectedIndex = 0;

                        if (!string.IsNullOrEmpty(Convert.ToString(lblProductionOrderItemCode.Text)))
                        {
                            ddlProductionOrderItemCode.SelectedValue = Convert.ToString(lblProductionOrderItemCode.Text);
                        }
                    }
                }
                else
                {
                    //ddlProductionOrderItemCode.Items.Clear();
                    ddlProductionOrderItemCode.Items.Insert(0, "SELECT");
                    ddlProductionOrderItemCode.SelectedIndex = 0;
                }


                //Binding of Item Name
                if (jobNoSI > 0 && productionOrderNoSI > 0)
                {
                    DataTable dtItemNameNew = new DataTable();
                    dtItemNameNew = dtItemName.Copy();
                    dtItemNameNew.Rows.Clear();

                    foreach (DataRow dr1 in dtItemName.Select("JOB_NO='" + jobNoSV + "' AND PRODUCTION_ORDER_NO='" + productionOrderNoSV + "'"))
                    {
                        DataRow drn = dtItemNameNew.NewRow();
                        drn["JOB_NO"] = Convert.ToString(dr1["JOB_NO"]);
                        drn["PRODUCTION_ORDER_NO"] = Convert.ToString(dr1["PRODUCTION_ORDER_NO"]);
                        drn["ITEM_NAME"] = Convert.ToString(dr1["ITEM_NAME"]);
                        dtItemNameNew.Rows.Add(drn);
                    }

                    if (dtItemNameNew != null && dtItemNameNew.Rows.Count > 0)
                    {
                        ddlItemName.DataSource = dtItemNameNew;
                        ddlItemName.DataTextField = "ITEM_NAME";
                        ddlItemName.DataValueField = "ITEM_NAME";
                        ddlItemName.DataBind();
                        ddlItemName.Items.Insert(0, "SELECT");
                        ddlItemName.SelectedIndex = 0;

                        if (!string.IsNullOrEmpty(Convert.ToString(lblItemName.Text)))
                        {
                            ddlItemName.SelectedValue = Convert.ToString(lblItemName.Text);
                        }
                    }
                }
                else
                {
                    //ddlItemName.Items.Clear();
                    ddlItemName.Items.Insert(0, "SELECT");
                    ddlItemName.SelectedIndex = 0;
                }


                //Binding of Tag No
                if (jobNoSI > 0 && productionOrderNoSI > 0)
                {
                    DataTable dtTagNoNew = new DataTable();
                    dtTagNoNew = dtTagNo.Copy();
                    dtTagNoNew.Rows.Clear();

                    foreach (DataRow dr1 in dtTagNo.Select("JOB_NO='" + jobNoSV + "' AND PRODUCTION_ORDER_NO='" + productionOrderNoSV + "'"))
                    {
                        DataRow drn = dtTagNoNew.NewRow();
                        drn["JOB_NO"] = Convert.ToString(dr1["JOB_NO"]);
                        drn["PRODUCTION_ORDER_NO"] = Convert.ToString(dr1["PRODUCTION_ORDER_NO"]);
                        drn["TAG_NO"] = Convert.ToString(dr1["TAG_NO"]);
                        dtTagNoNew.Rows.Add(drn);
                    }

                    if (dtTagNoNew != null && dtTagNoNew.Rows.Count > 0)
                    {
                        ddlTagNo.DataSource = dtTagNoNew;
                        ddlTagNo.DataTextField = "TAG_NO";
                        ddlTagNo.DataValueField = "TAG_NO";
                        ddlTagNo.DataBind();
                        ddlTagNo.Items.Insert(0, "SELECT");
                        ddlTagNo.SelectedIndex = 0;

                        if (!string.IsNullOrEmpty(Convert.ToString(lblTagNo.Text)))
                        {
                            ddlTagNo.SelectedValue = Convert.ToString(lblTagNo.Text);
                        }
                    }
                }
                else
                {
                    //ddlTagNo.Items.Clear();
                    ddlTagNo.Items.Insert(0, "SELECT");
                    ddlTagNo.SelectedIndex = 0;
                }




                //Binding of Activity
                ddlActivity.Items.Clear();
                ddlActivity.Items.Insert(0, "SELECT");

                if (dtActivity != null && dtActivity.Rows.Count > 0)
                {
                    ddlActivity.DataSource = dtActivity;
                    ddlActivity.DataTextField = "ACTIVITY_NAME";
                    ddlActivity.DataValueField = "ACTIVITY_PID";
                    ddlActivity.DataBind();
                    ddlActivity.Items.Insert(0, "SELECT");

                    foreach (DataRow dr in dtChanged.Select("SERIAL_NO='" + Convert.ToString(lblSerialNo.Text) + "' AND EMPLOYEE_CODE='" + Convert.ToString(lblEmpCode.Text) + "' AND JOB_NO ='" + Convert.ToString(ddlJOBNos.SelectedValue) + "'"))
                    {
                        if (!string.IsNullOrEmpty(Convert.ToString(dr["ACTIVITY_ID"])))
                        {
                            ddlActivity.SelectedValue = Convert.ToString(dr["ACTIVITY_ID"]);
                        }
                        //else
                        //{
                        //    ddlActivity.Items.Clear();
                        //    ddlActivity.Items.Insert(0, "SELECT");
                        //    ddlActivity.SelectedIndex = 0;
                        //}
                    }
                }


                #region MyRegion

                //DataTable dtJOBNo = (DataTable)Session["dtJOBNo"];
                //DataTable dtProductionOrderNo = (DataTable)Session["dtProductionOrderNo"];
                //DataTable dtProductionOrderItemCode = (DataTable)Session["dtProductionOrderItemCode"];
                //DataTable dtItemName = (DataTable)Session["dtItemName"];
                //DataTable dtTagNo = (DataTable)Session["dtTagNo"];

                //DataTable dtChanged = (DataTable)Session["dtChanged"];

                //if (dtJOBNo.Rows.Count > 0)
                //{
