                {
                    ddlItemName.DataSource = dtItemNameNew;
                    ddlItemName.DataTextField = "ITEM_NAME";
                    ddlItemName.DataValueField = "ITEM_NAME";
                    ddlItemName.DataBind();
                    ddlItemName.Items.Insert(0, "SELECT");
                    ddlItemName.SelectedIndex = 0;
                }
            }



            //Binding of Tag No
            if (jobNoSI > 0 && productionOrderNoSI > 0)
            {
                DataTable dtTagNoNew = new DataTable();
                dtTagNoNew = dtTagNo.Copy();
                dtTagNoNew.Rows.Clear();

                foreach (DataRow dr1 in dtTagNo.Select("JOB_NO='" + jobNoSV + "' AND PRODUCTION_ORDER_NO='" + productionOrderNoSV + "'"))
                {
                    DataRow drn = dtTagNoNew.NewRow();
                    drn["JOB_NO"] = Convert.ToString(dr1["JOB_NO"]);
                    drn["PRODUCTION_ORDER_NO"] = Convert.ToString(dr1["PRODUCTION_ORDER_NO"]);
                    drn["TAG_NO"] = Convert.ToString(dr1["TAG_NO"]);
                    dtTagNoNew.Rows.Add(drn);
                }

                if (dtTagNoNew != null && dtTagNoNew.Rows.Count > 0)
