                        jobNo = Convert.ToString(ddlJOBNos.SelectedValue);
                    else jobNo = string.Empty;

                    if (ddlEquipment.SelectedIndex > 0)
                        equipment = Convert.ToString(ddlEquipment.SelectedValue);
                    else equipment = string.Empty;

                    if (ddlProductionOrderNo.SelectedIndex > 0)
                        productionOrderNo = Convert.ToString(ddlProductionOrderNo.SelectedValue);
                    else productionOrderNo = string.Empty;

