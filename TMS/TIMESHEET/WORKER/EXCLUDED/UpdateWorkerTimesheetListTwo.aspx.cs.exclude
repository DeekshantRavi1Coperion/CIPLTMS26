    protected void ddlJOBNo_SelectedIndexChanged(object sender, EventArgs e)
    {
        try
        {
            GridViewRow gvr = (GridViewRow)(((Control)sender).NamingContainer);

            DropDownList ddlJOBNos = (DropDownList)gvr.FindControl("ddlJOBNo");
            DropDownList ddlEquipment = (DropDownList)gvr.FindControl("ddlEquipment");
            DropDownList ddlProductionOrderNo = (DropDownList)gvr.FindControl("ddlProductionOrderNo");
            DropDownList ddlProductionOrderItemCode = (DropDownList)gvr.FindControl("ddlProductionOrderItemCode");
            DropDownList ddlItemName = (DropDownList)gvr.FindControl("ddlItemName");
            DropDownList ddlTagNo = (DropDownList)gvr.FindControl("ddlTagNo");

            TextBox txtJOBNo = (TextBox)gvr.FindControl("txtJOBNo");
            TextBox txtItemName = (TextBox)gvr.FindControl("txtItemName");


            //DataSet dsJOBNo = (DataSet)Session["dsJOBNo"];
            DataTable dtJOBNo = (DataTable)Session["dtJOBNo"];
            DataTable dtEquipment = (DataTable)Session["dtEquipment"];
            DataTable dtProductionOrderNo = (DataTable)Session["dtProductionOrderNo"];
            DataTable dtProductionOrderItemCode = (DataTable)Session["dtProductionOrderItemCode"];
            DataTable dtItemName = (DataTable)Session["dtItemName"];
            DataTable dtTagNo = (DataTable)Session["dtTagNo"];


            ddlEquipment.Items.Clear();
            ddlEquipment.Items.Insert(0, "SELECT");
            ddlEquipment.SelectedIndex = 0;

            ddlProductionOrderNo.Items.Clear();
            ddlProductionOrderNo.Items.Insert(0, "SELECT");
            ddlProductionOrderNo.SelectedIndex = 0;

            ddlProductionOrderItemCode.Items.Clear();
            ddlProductionOrderItemCode.Items.Insert(0, "SELECT");
            ddlProductionOrderItemCode.SelectedIndex = 0;

            ddlItemName.Items.Clear();
            ddlItemName.Items.Insert(0, "SELECT");
            ddlItemName.SelectedIndex = 0;

            ddlTagNo.Items.Clear();
            ddlTagNo.Items.Insert(0, "SELECT");
            ddlTagNo.SelectedIndex = 0;


            int jobNoSI = 0;
            int equipmentSI = 0;
            int productionOrderNoSI = 0;

            string jobNoSV = string.Empty;
            string equipmentSV = string.Empty;
            string productionOrderNoSV = string.Empty;

            jobNoSI = Convert.ToInt32(ddlJOBNos.SelectedIndex);
            if (jobNoSI > 0)
                jobNoSV = Convert.ToString(ddlJOBNos.SelectedValue);

            //Binding of Equipment
            if (jobNoSI > 0)
            {
                DataTable dtEquipmentNew = new DataTable();
                dtEquipmentNew = dtEquipment.Copy();
                dtEquipmentNew.Rows.Clear();

                foreach (DataRow dr1 in dtEquipment.Select("JOB_NO='" + jobNoSV + "'"))
                {
                    DataRow drn = dtEquipmentNew.NewRow();
                    drn["JOB_NO"] = Convert.ToString(dr1["JOB_NO"]);
                    drn["EQUIPMENT"] = Convert.ToString(dr1["EQUIPMENT"]);
                    dtEquipmentNew.Rows.Add(drn);
                }

                if (dtEquipmentNew != null && dtEquipmentNew.Rows.Count > 0)
                {
                    ddlEquipment.DataSource = dtEquipmentNew;
                    ddlEquipment.DataTextField = "EQUIPMENT";
                    ddlEquipment.DataValueField = "EQUIPMENT";
                    ddlEquipment.DataBind();
                    ddlEquipment.Items.Insert(0, "SELECT");
                    ddlEquipment.SelectedIndex = 0;
                }
            }


            equipmentSI = Convert.ToInt32(ddlEquipment.SelectedIndex);
            if (equipmentSI > 0)
                equipmentSV = Convert.ToString(ddlEquipment.SelectedValue);

            //Binding of Production Order No
            if (jobNoSI > 0)
            {
                DataTable dtProductionOrderNoNew = new DataTable();
                dtProductionOrderNoNew = dtProductionOrderNo.Copy();
                dtProductionOrderNoNew.Rows.Clear();

                foreach (DataRow dr1 in dtProductionOrderNo.Select("JOB_NO='" + jobNoSV + "' AND EQUIPMENT ='" + equipmentSV + "'"))
                {
                    DataRow drn = dtProductionOrderNoNew.NewRow();
                    drn["JOB_NO"] = Convert.ToString(dr1["JOB_NO"]);
                    drn["EQUIPMENT"] = Convert.ToString(dr1["EQUIPMENT"]);
                    drn["PRODUCTION_ORDER_NO"] = Convert.ToString(dr1["PRODUCTION_ORDER_NO"]);
                    dtProductionOrderNoNew.Rows.Add(drn);
                }

                if (dtProductionOrderNoNew != null && dtProductionOrderNoNew.Rows.Count > 0)
                {
                    ddlProductionOrderNo.DataSource = dtProductionOrderNoNew;
                    ddlProductionOrderNo.DataTextField = "PRODUCTION_ORDER_NO";
                    ddlProductionOrderNo.DataValueField = "PRODUCTION_ORDER_NO";
                    ddlProductionOrderNo.DataBind();
                    ddlProductionOrderNo.Items.Insert(0, "SELECT");
                    ddlProductionOrderNo.SelectedIndex = 0;
                }
            }


            productionOrderNoSI = Convert.ToInt32(ddlProductionOrderNo.SelectedIndex);
            if (productionOrderNoSI > 0)
                productionOrderNoSV = Convert.ToString(ddlProductionOrderNo.SelectedValue);

            //Binding of Production Order Item Code
            if (jobNoSI > 0 && productionOrderNoSI > 0)
            {
                DataTable dtProductionOrderItemCodeNew = new DataTable();
                dtProductionOrderItemCodeNew = dtProductionOrderItemCode.Copy();
                dtProductionOrderItemCodeNew.Rows.Clear();

                foreach (DataRow dr1 in dtProductionOrderItemCode.Select("JOB_NO='" + jobNoSV + "' AND PRODUCTION_ORDER_NO='" + productionOrderNoSV + "'"))
                {
                    DataRow drn = dtProductionOrderItemCodeNew.NewRow();
                    drn["JOB_NO"] = Convert.ToString(dr1["JOB_NO"]);
                    drn["PRODUCTION_ORDER_NO"] = Convert.ToString(dr1["PRODUCTION_ORDER_NO"]);
                    drn["SUBITEM_DESC"] = Convert.ToString(dr1["SUBITEM_DESC"]);
                    dtProductionOrderItemCodeNew.Rows.Add(drn);
                }

                if (dtProductionOrderItemCodeNew != null && dtProductionOrderItemCodeNew.Rows.Count > 0)
                {
                    ddlProductionOrderItemCode.DataSource = dtProductionOrderItemCodeNew;
                    ddlProductionOrderItemCode.DataTextField = "SUBITEM_DESC";
                    ddlProductionOrderItemCode.DataValueField = "SUBITEM_DESC";
                    ddlProductionOrderItemCode.DataBind();
                    ddlProductionOrderItemCode.Items.Insert(0, "SELECT");
                    ddlProductionOrderItemCode.SelectedIndex = 0;
                }
            }


            //Binding of Item Name
            if (jobNoSI > 0 && productionOrderNoSI > 0)
            {
                DataTable dtItemNameNew = new DataTable();
                dtItemNameNew = dtItemName.Copy();
                dtItemNameNew.Rows.Clear();

                foreach (DataRow dr1 in dtItemName.Select("JOB_NO='" + jobNoSV + "' AND PRODUCTION_ORDER_NO='" + productionOrderNoSV + "'"))
                {
                    DataRow drn = dtItemNameNew.NewRow();
                    drn["JOB_NO"] = Convert.ToString(dr1["JOB_NO"]);
                    drn["PRODUCTION_ORDER_NO"] = Convert.ToString(dr1["PRODUCTION_ORDER_NO"]);
                    drn["ITEM_NAME"] = Convert.ToString(dr1["ITEM_NAME"]);
                    dtItemNameNew.Rows.Add(drn);
                }

                if (dtItemNameNew != null && dtItemNameNew.Rows.Count > 0)
                {
                    ddlItemName.DataSource = dtItemNameNew;
                    ddlItemName.DataTextField = "ITEM_NAME";
                    ddlItemName.DataValueField = "ITEM_NAME";
                    ddlItemName.DataBind();
                    ddlItemName.Items.Insert(0, "SELECT");
                    ddlItemName.SelectedIndex = 0;
                }
            }



            //Binding of Tag No
            if (jobNoSI > 0 && productionOrderNoSI > 0)
            {
                DataTable dtTagNoNew = new DataTable();
                dtTagNoNew = dtTagNo.Copy();
                dtTagNoNew.Rows.Clear();

                foreach (DataRow dr1 in dtTagNo.Select("JOB_NO='" + jobNoSV + "' AND PRODUCTION_ORDER_NO='" + productionOrderNoSV + "'"))
                {
                    DataRow drn = dtTagNoNew.NewRow();
                    drn["JOB_NO"] = Convert.ToString(dr1["JOB_NO"]);
                    drn["PRODUCTION_ORDER_NO"] = Convert.ToString(dr1["PRODUCTION_ORDER_NO"]);
                    drn["TAG_NO"] = Convert.ToString(dr1["TAG_NO"]);
                    dtTagNoNew.Rows.Add(drn);
                }

                if (dtTagNoNew != null && dtTagNoNew.Rows.Count > 0)
                {
                    ddlTagNo.DataSource = dtTagNoNew;
                    ddlTagNo.DataTextField = "TAG_NO";
                    ddlTagNo.DataValueField = "TAG_NO";
                    ddlTagNo.DataBind();
                    ddlTagNo.Items.Insert(0, "SELECT");
                    ddlTagNo.SelectedIndex = 0;
                }
            }

        }
        catch (Exception ex)
        {
            ExceptionMessage(ex.ToString());
            return;
        }
    }



