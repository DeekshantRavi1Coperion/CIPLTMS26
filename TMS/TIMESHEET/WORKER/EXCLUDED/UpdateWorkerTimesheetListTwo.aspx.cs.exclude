                    ddlProductionOrderNo.Items.Insert(0, "SELECT");
                    ddlProductionOrderNo.SelectedIndex = 0;
                }


                productionOrderNoSI = Convert.ToInt32(ddlProductionOrderNo.SelectedIndex);
                if (productionOrderNoSI > 0)
                    productionOrderNoSV = Convert.ToString(ddlProductionOrderNo.SelectedValue);

                //Binding of Production Order Item Code
                if (jobNoSI > 0 && productionOrderNoSI > 0)
                {
                    DataTable dtProductionOrderItemCodeNew = new DataTable();
                    dtProductionOrderItemCodeNew = dtProductionOrderItemCode.Copy();
                    dtProductionOrderItemCodeNew.Rows.Clear();

                    foreach (DataRow dr1 in dtProductionOrderItemCode.Select("JOB_NO='" + jobNoSV + "' AND PRODUCTION_ORDER_NO='" + productionOrderNoSV + "'"))
                    {
                        DataRow drn = dtProductionOrderItemCodeNew.NewRow();
                        drn["JOB_NO"] = Convert.ToString(dr1["JOB_NO"]);
                        drn["PRODUCTION_ORDER_NO"] = Convert.ToString(dr1["PRODUCTION_ORDER_NO"]);
                        drn["SUBITEM_DESC"] = Convert.ToString(dr1["SUBITEM_DESC"]);
                        dtProductionOrderItemCodeNew.Rows.Add(drn);
                    }

                    if (dtProductionOrderItemCodeNew != null && dtProductionOrderItemCodeNew.Rows.Count > 0)
                    {
                        ddlProductionOrderItemCode.DataSource = dtProductionOrderItemCodeNew;
                        ddlProductionOrderItemCode.DataTextField = "SUBITEM_DESC";
                        ddlProductionOrderItemCode.DataValueField = "SUBITEM_DESC";
                        ddlProductionOrderItemCode.DataBind();
                        ddlProductionOrderItemCode.Items.Insert(0, "SELECT");
                        ddlProductionOrderItemCode.SelectedIndex = 0;

                        if (!string.IsNullOrEmpty(Convert.ToString(lblProductionOrderItemCode.Text)))
                        {
                            ddlProductionOrderItemCode.SelectedValue = Convert.ToString(lblProductionOrderItemCode.Text);
                        }
                    }
                }
                else
                {
                    //ddlProductionOrderItemCode.Items.Clear();
                    ddlProductionOrderItemCode.Items.Insert(0, "SELECT");
                    ddlProductionOrderItemCode.SelectedIndex = 0;
                }


                //Binding of Item Name
                if (jobNoSI > 0 && productionOrderNoSI > 0)
                {
                    DataTable dtItemNameNew = new DataTable();
                    dtItemNameNew = dtItemName.Copy();
                    dtItemNameNew.Rows.Clear();

                    foreach (DataRow dr1 in dtItemName.Select("JOB_NO='" + jobNoSV + "' AND PRODUCTION_ORDER_NO='" + productionOrderNoSV + "'"))
                    {
                        DataRow drn = dtItemNameNew.NewRow();
                        drn["JOB_NO"] = Convert.ToString(dr1["JOB_NO"]);
                        drn["PRODUCTION_ORDER_NO"] = Convert.ToString(dr1["PRODUCTION_ORDER_NO"]);
                        drn["ITEM_NAME"] = Convert.ToString(dr1["ITEM_NAME"]);
                        dtItemNameNew.Rows.Add(drn);
                    }

                    if (dtItemNameNew != null && dtItemNameNew.Rows.Count > 0)
                    {
                        ddlItemName.DataSource = dtItemNameNew;
                        ddlItemName.DataTextField = "ITEM_NAME";
                        ddlItemName.DataValueField = "ITEM_NAME";
                        ddlItemName.DataBind();
                        ddlItemName.Items.Insert(0, "SELECT");
                        ddlItemName.SelectedIndex = 0;

                        if (!string.IsNullOrEmpty(Convert.ToString(lblItemName.Text)))
                        {
                            ddlItemName.SelectedValue = Convert.ToString(lblItemName.Text);
                        }
                    }
                }
                else
                {
                    //ddlItemName.Items.Clear();
                    ddlItemName.Items.Insert(0, "SELECT");
                    ddlItemName.SelectedIndex = 0;
                }


                //Binding of Tag No
                if (jobNoSI > 0 && productionOrderNoSI > 0)
                {
                    DataTable dtTagNoNew = new DataTable();
                    dtTagNoNew = dtTagNo.Copy();
                    dtTagNoNew.Rows.Clear();

                    foreach (DataRow dr1 in dtTagNo.Select("JOB_NO='" + jobNoSV + "' AND PRODUCTION_ORDER_NO='" + productionOrderNoSV + "'"))
                    {
                        DataRow drn = dtTagNoNew.NewRow();
                        drn["JOB_NO"] = Convert.ToString(dr1["JOB_NO"]);
                        drn["PRODUCTION_ORDER_NO"] = Convert.ToString(dr1["PRODUCTION_ORDER_NO"]);
                        drn["TAG_NO"] = Convert.ToString(dr1["TAG_NO"]);
                        dtTagNoNew.Rows.Add(drn);
                    }

                    if (dtTagNoNew != null && dtTagNoNew.Rows.Count > 0)
                    {
                        ddlTagNo.DataSource = dtTagNoNew;
                        ddlTagNo.DataTextField = "TAG_NO";
                        ddlTagNo.DataValueField = "TAG_NO";
                        ddlTagNo.DataBind();
                        ddlTagNo.Items.Insert(0, "SELECT");
                        ddlTagNo.SelectedIndex = 0;

                        if (!string.IsNullOrEmpty(Convert.ToString(lblTagNo.Text)))
                        {
                            ddlTagNo.SelectedValue = Convert.ToString(lblTagNo.Text);
                        }
                    }
                }
                else
                {
                    //ddlTagNo.Items.Clear();
                    ddlTagNo.Items.Insert(0, "SELECT");
                    ddlTagNo.SelectedIndex = 0;
                }




                //Binding of Activity
                ddlActivity.Items.Clear();
                ddlActivity.Items.Insert(0, "SELECT");

                if (dtActivity != null && dtActivity.Rows.Count > 0)
                {
                    ddlActivity.DataSource = dtActivity;
                    ddlActivity.DataTextField = "ACTIVITY_NAME";
                    ddlActivity.DataValueField = "ACTIVITY_PID";
                    ddlActivity.DataBind();
                    ddlActivity.Items.Insert(0, "SELECT");

                    foreach (DataRow dr in dtChanged.Select("SERIAL_NO='" + Convert.ToString(lblSerialNo.Text) + "' AND EMPLOYEE_CODE='" + Convert.ToString(lblEmpCode.Text) + "' AND JOB_NO ='" + Convert.ToString(ddlJOBNos.SelectedValue) + "'"))
                    {
                        if (!string.IsNullOrEmpty(Convert.ToString(dr["ACTIVITY_ID"])))
                        {
                            ddlActivity.SelectedValue = Convert.ToString(dr["ACTIVITY_ID"]);
                        }
                    }
                }


                //if (dsJOBNo.Tables.Count > 0 && dsJOBNo.Tables[0].Rows.Count > 0)
                //{
                //    ddlJOBNos.DataSource = dsJOBNo.Tables[0];
                //    ddlJOBNos.DataTextField = "JOB_NO";
                //    ddlJOBNos.DataValueField = "JOB_NO";
                //    ddlJOBNos.DataBind();
                //    ddlJOBNos.Items.Insert(0, "SELECT");

                //    foreach (DataRow dr in dtChanged.Select("SERIAL_NO='" + Convert.ToString(lblSerialNo.Text) + "' AND EMPLOYEE_CODE='" + Convert.ToString(lblEmpCode.Text) + "'"))
                //    {
                //        if (!string.IsNullOrEmpty(Convert.ToString(dr["JOB_NO"])))
                //            ddlJOBNos.SelectedValue = Convert.ToString(dr["JOB_NO"]);
                //    }
                //}


                //ddlSubitems.Items.Clear();
                //ddlSubitems.Items.Insert(0, "SELECT");
                //ddlSubitems.SelectedIndex = 0;

                //if (dtSubitems.Rows.Count > 0)
                //{
                //    if (ddlJOBNos.SelectedIndex > 0)
                //    {
                //        DataTable dtNew = new DataTable();
                //        dtNew.Columns.Add("SUBITEM_DESC", typeof(string));

                //        foreach (DataRow drs in dtSubitems.Select("JOB_NO='" + Convert.ToString(ddlJOBNos.SelectedValue) + "'"))
                //        {
                //            if (!string.IsNullOrEmpty(Convert.ToString(drs["SUBITEM_DESC"])))
                //            {
                //                DataRow drn = dtNew.NewRow();
                //                drn["SUBITEM_DESC"] = drs["SUBITEM_DESC"];
                //                dtNew.Rows.Add(drn);
                //            }
                //        }

