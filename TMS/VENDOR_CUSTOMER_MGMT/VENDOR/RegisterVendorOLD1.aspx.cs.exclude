    #region METHODS[=========================]

    private void BindCategory()
    {
        try
        {
            dsCategory = objVCM.GetCategorys();
            if (dsCategory.Tables.Count > 0 && dsCategory.Tables[0].Rows.Count > 0)
            {
                ddlCategory.DataSource = dsCategory.Tables[0];
                ddlCategory.DataTextField = "NAME";
                ddlCategory.DataValueField = "PID";
                ddlCategory.DataBind();
                ddlCategory.Items.Insert(0, "Select");
            }
        }
        catch (Exception ex)
        {
            ExceptionMessage(ex.ToString());
            return;
        }
    }

    private void BindResponsible()
    {
        try
        {
            dsResponsible = objVCM.GetResponsibles();
            if (dsResponsible.Tables.Count > 0 && dsResponsible.Tables[0].Rows.Count > 0)
            {
                ddlResponsible.DataSource = dsResponsible.Tables[0];
                ddlResponsible.DataTextField = "NAME";
                ddlResponsible.DataValueField = "PID";
                ddlResponsible.DataBind();
                ddlResponsible.Items.Insert(0, "Select");
            }
        }
        catch (Exception ex)
        {
            ExceptionMessage(ex.ToString());
            return;
        }
    }

