                                <asp:TextBox ID="txtPANNumber" runat="server" Width="100%" />
                            </td>
                        </tr>
                        <tr>
                            <td>&nbsp;</td>
                        </tr>
                        <tr>
                            <td style="width: 30%;">GSTIn:</td>
