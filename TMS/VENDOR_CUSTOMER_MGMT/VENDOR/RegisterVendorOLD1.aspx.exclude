                                                            <asp:Label ID="lblBankName" runat="server" Text='<%# Eval("BANK_NAME") %>' Visible="false" />
                                                            <asp:Label ID="lblBranch" runat="server" Text='<%# Eval("BRANCH") %>' Visible="false" />
                                                            <asp:Label ID="lblSWIFTCode" runat="server" Text='<%# Eval("SWIFT_CODE") %>' Visible="false" />
                                                            <asp:Label ID="lblAccountNumber" runat="server" Text='<%# Eval("ACCOUNT_NUMBER") %>' Visible="false" />
                                                            <asp:Label ID="lblRTGSOrIFSC" runat="server" Text='<%# Eval("RTGS_OR_IFSC_CODE") %>' Visible="false" />
                                                            <asp:Label ID="lblISBN" runat="server" Text='<%# Eval("ISBN") %>' Visible="false" />
                                                            <asp:Label ID="lblIsDefault" runat="server" Text='<%# Eval("IS_DEFAULT") %>' Visible="false" />

                                                            <asp:TextBox ID="txtSrNo" runat="server" Text='<%# Eval("SR_NO") %>' Width="30PX"
                                                                onkeyDown="javascript:preventInput(event);" CssClass="textboxcenter"></asp:TextBox>
                                                        </ItemTemplate>
                                                    </asp:TemplateField>

                                                    <asp:BoundField DataField="BANK_NAME" HeaderText="Bank Name" />
                                                    <asp:BoundField DataField="BRANCH" HeaderText="Branch" />
                                                    <asp:BoundField DataField="SWIFT_CODE" HeaderText="SWIFT Code" />
                                                    <asp:BoundField DataField="ACCOUNT_NUMBER" HeaderText="Account No." />
                                                    <asp:BoundField DataField="RTGS_OR_IFSC_CODE" HeaderText="RTGS/IFSC" />
