                                <asp:TextBox ID="txtGSTIn" runat="server" Width="100%" />
                            </td>
                        </tr>
                        <tr>
                            <td>&nbsp;</td>
                        </tr>
                        <tr>
                            <td style="width: 30%;">Credit Days:</td>
                            <td>
                                <asp:TextBox ID="txtCreditDays" runat="server" Width="100%" Text="0"
                                    onkeypress="return inNumberKeyWithDecimal(this, event);" />
                            </td>
                        </tr>
                        <tr>
                            <td>&nbsp;</td>
                        </tr>
                        <tr>
                            <td style="width: 20%;">Credit Limit:</td>
                            <td>
                                <asp:TextBox ID="txtCreditLimit" runat="server" Width="100%" Text="0"
                                    onkeypress="return inNumberKeyWithDecimal(this, event);" />
                            </td>
                        </tr>
                        <tr>
                            <td>&nbsp;</td>
                        </tr>
                        <tr>
                            <td style="width: 30%;">Category:</td>
                            <td>
                                <asp:DropDownList ID="ddlCategory" runat="server" Width="100%" Height="26px">
                                </asp:DropDownList>
                            </td>
                        </tr>
                        <tr>
                            <td>&nbsp;</td>
                        </tr>
                        <tr>
                            <td style="width: 30%;">Is MSMED?:</td>
