        /*Attachment=================================================================*/

        function ValidatefileAttachment() {
            var allowedFiles = [".jpg", ".jpeg", ".bmp", ".png", ".gif", ".pdf", ".JPG", ".JPEG", ".BMP", ".PNG", ".GIF", ".PDF"];
            var regex = new RegExp("([a-zA-Z0-9\s_\\.\-:])+(" + allowedFiles.join('|') + ")$");
            var fileAttachment4 = document.getElementById('<%=fileUploadAttachment.ClientID %>').value;
            var divfileAttachment4 = document.getElementById("divfileAttachment");
            var lblfileAttachment4 = document.getElementById('<%=lblfileAttachment.ClientID %>');

            if (fileAttachment4 == '') {
                document.getElementById('<%=fileUploadAttachment.ClientID %>').style.borderColor = "";
                divfileAttachment4.style.display = "block";
                lblfileAttachment4.innerHTML = "Please upload file";
                return true;
            }
            else {

                fileAttachment4 = fileAttachment4.split(" ").join("")
                fileAttachment4 = fileAttachment4.split("(").join("")
                fileAttachment4 = fileAttachment4.split(")").join("")

                if (!regex.test(fileAttachment4.toLowerCase())) {
                    document.getElementById('<%=fileUploadAttachment.ClientID %>').style.borderColor = "#F7627F";
                    divfileAttachment4.style.display = "block";
                    lblfileAttachment4.innerHTML = "Please enter only .pdf, .jpg, .jpeg, .bmp, .png, .gif file!";
                    return true;
                }
                else {
                    document.getElementById('<%=fileUploadAttachment.ClientID %>').style.borderColor = "";
                    divfileAttachment4.style.display = "none";
                    lblfileAttachment4.innerHTML = "";
                    return false;
                }
            }
        }

    </script>



    <%--/*Apply Validation Functions===========================================================*/--%>
    <script type="text/Javascript">

        function ValidateVendorBasicDetails() {

            displayNoneAllPanels();

            var check = true;

            if (ValidateName()) { check = false; }
            if (ValidatePANNumber()) { check = false; }
            if (ValidateGSTIn()) { check = false; }
            if (ValidateCategory()) { check = false; }

            if (check) {
                document.getElementById('<%= imgBtnShowPnl2.ClientID %>').src = '<%= ResolveUrl("~/Images/VCM/a_pnl2.png") %>';
                document.getElementById('<%= pnlBillingAddress.ClientID %>').style.display = 'block';
            }
            else {
                document.getElementById('<%= pnlVendorDetails.ClientID %>').style.display = 'block';
            }

            return false;
        }



        function ValidateBillingAddress() {
            var check = true;

            if (ValidateAddress1()) { check = false; }
            if (ValidateCity()) { check = false; }
            if (ValidateState()) { check = false; }
            if (ValidateCountry()) { check = false; }
            if (ValidatePhone()) { check = false; }
            if (ValidateEmail()) { check = false; }

            if (check) {

                return true;
            }
            else {
                return false;
            }

            return check;
        }


        function ValidateBillingAddressGrid() {


            displayNoneAllPanels();

            document.getElementById('<%= lblBillingAddressMsg.ClientID %>').innerText = ''
            var check = false;
            var grid = document.getElementById('<%= gvBillingAddress.ClientID %>');
            if (grid != null) {

                var rows = grid.getElementsByTagName('tr');
                if (rows.length > 1) {
                    check = true;
                }
            }

            if (check) {
                document.getElementById('<%= imgBtnShowPnl3.ClientID %>').src = '<%= ResolveUrl("~/Images/VCM/a_pnl3.png") %>';
                document.getElementById('<%= pnlContactPerson.ClientID %>').style.display = 'block';
            }
            else {
                document.getElementById('<%= pnlBillingAddress.ClientID %>').style.display = 'block';
                document.getElementById('<%= lblBillingAddressMsg.ClientID %>').innerText = 'Please add at least one billing address.'
            }

            return false;
        }



        function ValidateContactPerson() {
            var check = true;

            if (ValidateContactPersonName()) { check = false; }
            if (ValidateContactPersonMobile()) { check = false; }
            if (ValidateContactPersonPhone()) { check = false; }
            if (ValidateContactPersonEmail()) { check = false; }

            if (check) {
                return true;
            }
            else {
                return false;
            }

            return check;
        }

        function ValidateContactPersonGrid() {

            displayNoneAllPanels();

            document.getElementById('<%= lblContactPersonMsg.ClientID %>').innerText = ''
            var check = false;
            var grid = document.getElementById('<%= gvContactPerson.ClientID %>');
            if (grid != null) {

                var rows = grid.getElementsByTagName('tr');
                if (rows.length > 1) {
                    check = true;
                }
            }

            if (check) {
                document.getElementById('<%= imgBtnShowPnl4.ClientID %>').src = '<%= ResolveUrl("~/Images/VCM/a_pnl4.png") %>';
                document.getElementById('<%= pnlBankDetails.ClientID %>').style.display = 'block';
            }
            else {
                document.getElementById('<%= pnlContactPerson.ClientID %>').style.display = 'block';
                document.getElementById('<%= lblContactPersonMsg.ClientID %>').innerText = 'Please add at least one contact person.'
            }

            return false;
        }


        function ValidateBankDetails() {
            var check = true;

            if (ValidateBankName()) { check = false; }
            if (ValidateBranch()) { check = false; }
            if (ValidateSWIFTCode()) { check = false; }
            if (ValidateAccountNumber()) { check = false; }
            if (ValidateRTGSOrIFSC()) { check = false; }
            if (ValidateISBN()) { check = false; }

            if (check) {
                return true;
            }
            else {
                return false;
            }

            return check;
        }


        function ValidateBankDetailsGrid() {

            displayNoneAllPanels();

            document.getElementById('<%= lblBankDetailsMsg.ClientID %>').innerText = ''
            var check = false;
            var grid = document.getElementById('<%= gvBankDetails.ClientID %>');
            if (grid != null) {

                var rows = grid.getElementsByTagName('tr');
                if (rows.length > 1) {
                    check = true;
                }
            }

            if (check) {
                document.getElementById('<%= imgBtnShowPnl5.ClientID %>').src = '<%= ResolveUrl("~/Images/VCM/a_pnl5.png") %>';
                document.getElementById('<%= pnlVendorOtherDetails.ClientID %>').style.display = 'block';
            }
            else {
                document.getElementById('<%= pnlBankDetails.ClientID %>').style.display = 'block';
                document.getElementById('<%= lblContactPersonMsg.ClientID %>').innerText = 'Please add at least one bank detail.'
            }

            return false;
        }


        function ValidateOtherDetails() {

            displayNoneAllPanels();

            var check = true;

            if (ValidateResponsible()) { check = false; }
            if (ValidateRelationType()) { check = false; }
            if (ValidateItemCategory()) { check = false; }
            if (ValidateItemSubCategory()) { check = false; }

            if (check) {
                document.getElementById('<%= imgBtnShowPnl6.ClientID %>').src = '<%= ResolveUrl("~/Images/VCM/a_pnl6.png") %>';
                document.getElementById('<%= pnlAttachments.ClientID %>').style.display = 'block';
            }
            else {
                document.getElementById('<%= pnlVendorOtherDetails.ClientID %>').style.display = 'block';
            }

            return false;
        }


        function ValidateAllAttachment() {
            var check = true;

            if (ValidatefileAttachment()) {
                check = false;
            }

            return check;
        }



        function ValidateAll() {
            var check = true;

            if (ValidateName()) { check = false; }
            if (ValidatePANNumber()) { check = false; }
            if (ValidateGSTIn()) { check = false; }
            if (ValidateCategory()) { check = false; }

            if (ValidateResponsible()) { check = false; }
            if (ValidateRelationType()) { check = false; }
            if (ValidateItemCategory()) { check = false; }
            if (ValidateItemSubCategory()) { check = false; }

            if (check) {
                if (confirm("Would you like to save Vendor?")) {
                    document.getElementById('<%=hdConfirmValue.ClientID %>').value = "1";
                    return true;
                }
                else {
                    document.getElementById('<%=hdConfirmValue.ClientID %>').value = "0";
                    return false;
                }
            }
            else {
                return false;
            }

            return check;
        }



        function ValidateAllForPreview() {
            var check = true;

            if (ValidateName()) { check = false; }
            if (ValidatePANNumber()) { check = false; }
            if (ValidateGSTIn()) { check = false; }
            if (ValidateCategory()) { check = false; }

            if (ValidateResponsible()) { check = false; }
            if (ValidateRelationType()) { check = false; }
            if (ValidateItemCategory()) { check = false; }
            if (ValidateItemSubCategory()) { check = false; }

            if (check) {
                if (confirm("Would you like to preview vendor details?")) {
                    return true;
                }
                else {
                    return false;
                }
            }
            else {
                return false;
            }

            return check;
        }

    </script>



    <%--/*Paneling Functions===================================================================*/--%>
    <script type="text/Javascript">

        function displayNoneAllPanels() {

            document.getElementById('<%= imgBtnShowPnl1.ClientID %>').src = '<%= ResolveUrl("~/Images/VCM/pnl1.png") %>';
            document.getElementById('<%= imgBtnShowPnl2.ClientID %>').src = '<%= ResolveUrl("~/Images/VCM/pnl2.png") %>';
            document.getElementById('<%= imgBtnShowPnl3.ClientID %>').src = '<%= ResolveUrl("~/Images/VCM/pnl3.png") %>';
            document.getElementById('<%= imgBtnShowPnl4.ClientID %>').src = '<%= ResolveUrl("~/Images/VCM/pnl4.png") %>';
            document.getElementById('<%= imgBtnShowPnl5.ClientID %>').src = '<%= ResolveUrl("~/Images/VCM/pnl5.png") %>';
            document.getElementById('<%= imgBtnShowPnl6.ClientID %>').src = '<%= ResolveUrl("~/Images/VCM/pnl6.png") %>';

            document.getElementById('<%= pnlVendorDetails.ClientID %>').style.display = 'none';
            document.getElementById('<%= pnlBillingAddress.ClientID %>').style.display = 'none';
            document.getElementById('<%= pnlContactPerson.ClientID %>').style.display = 'none';
            document.getElementById('<%= pnlBankDetails.ClientID %>').style.display = 'none';
            document.getElementById('<%= pnlVendorOtherDetails.ClientID %>').style.display = 'none';
            document.getElementById('<%= pnlAttachments.ClientID %>').style.display = 'none';
        }

        function ShowBillingAddressPopup() {
            document.getElementById('<%= hdBillingAddressUpdationFlag.ClientID %>').value = '0';
            document.getElementById('<%= btnAddUpdateAddressToList.ClientID %>').value = 'Add Address';
            $find('<%= mpeAddBillingAddress.ClientID %>').show();
        }

        function ShowContactPersonPopup() {
            document.getElementById('<%= hdContactPersonUpdationFlag.ClientID %>').value = '0';
            document.getElementById('<%= btnAddUpdateContactPersonToList.ClientID %>').value = 'Add Contact Person';
            $find('<%= mpeAddContactPerson.ClientID %>').show();
        }

        function ShowBankDetailPopup() {
            document.getElementById('<%= hdBankDetailsUpdationFlag.ClientID %>').value = '0';
            document.getElementById('<%= btnAddUpdateBankDetailsToList.ClientID %>').value = 'Add Bank Detail';
            $find('<%= mpeAddBankDetails.ClientID %>').show();
        }



        <%--function ShowVendorDetailsPanel() {

            displayNoneAllPanels();
            document.getElementById('<%= pnlVendorDetails.ClientID %>').style.display = 'block';
            return false;
        }

        function ShowBillingAddressPanel() {

            displayNoneAllPanels();
            document.getElementById('<%= pnlBillingAddress.ClientID %>').style.display = 'block';
            return false;
        }


        function ShowContactPersonPanel() {

            displayNoneAllPanels();
            document.getElementById('<%= pnlContactPerson.ClientID %>').style.display = 'block';
            return false;
        }

        function ShowBankDetailsPanel() {

            displayNoneAllPanels();
            document.getElementById('<%= pnlBankDetails.ClientID %>').style.display = 'block';
            return false;
        }

        function ShowVendorOtherDetailsPanel() {

            displayNoneAllPanels();
            document.getElementById('<%= pnlVendorOtherDetails.ClientID %>').style.display = 'block';
            return false;
        }

        function ShowAttachmentsPanel() {

            displayNoneAllPanels();
            document.getElementById('<%= pnlAttachments.ClientID %>').style.display = 'block';
            return false;
        }--%>


        function ShowPanel(id) {

            displayNoneAllPanels();

            if (id == 1) {
                document.getElementById('<%= imgBtnShowPnl1.ClientID %>').src = '<%= ResolveUrl("~/Images/VCM/a_pnl1.png") %>';
                document.getElementById('<%= pnlVendorDetails.ClientID %>').style.display = 'block';
            }
            else if (id == 2) {
                document.getElementById('<%= imgBtnShowPnl2.ClientID %>').src = '<%= ResolveUrl("~/Images/VCM/a_pnl2.png") %>';
                document.getElementById('<%= pnlBillingAddress.ClientID %>').style.display = 'block';
            }
            else if (id == 3) {
                document.getElementById('<%= imgBtnShowPnl3.ClientID %>').src = '<%= ResolveUrl("~/Images/VCM/a_pnl3.png") %>';
                document.getElementById('<%= pnlContactPerson.ClientID %>').style.display = 'block';
            }
            else if (id == 4) {
                document.getElementById('<%= imgBtnShowPnl4.ClientID %>').src = '<%= ResolveUrl("~/Images/VCM/a_pnl4.png") %>';
                document.getElementById('<%= pnlBankDetails.ClientID %>').style.display = 'block';
            }
            else if (id == 5) {
                document.getElementById('<%= imgBtnShowPnl5.ClientID %>').src = '<%= ResolveUrl("~/Images/VCM/a_pnl5.png") %>';
                document.getElementById('<%= pnlVendorOtherDetails.ClientID %>').style.display = 'block';
            }
            else if (id == 6) {
                document.getElementById('<%= imgBtnShowPnl6.ClientID %>').src = '<%= ResolveUrl("~/Images/VCM/a_pnl6.png") %>';
                document.getElementById('<%= pnlAttachments.ClientID %>').style.display = 'block';
            }

            return false;
        }


    </script>


</asp:Content>
<asp:Content ID="Content2" ContentPlaceHolderID="ContentPlaceHolder2" runat="Server">
    <ajax:ToolkitScriptManager ID="ScriptManager2" runat="server">
    </ajax:ToolkitScriptManager>
    <asp:HiddenField ID="hdConfirmValue" runat="server" />
    <asp:HiddenField ID="hdSubitemConfirmValue" runat="server" />

    <%--<div align="center" style="margin-top: 80px;">--%>
    <div style='margin-top: 80px;' align="center">
        <%--<fieldset style="width: 60%;">--%>
        <fieldset style="width: 60%;">
            <legend style="text-align: center;">Register Vendor</legend>

            <div style='width: 100%; border: 1px solid lightgray;'>

                <%--<asp:Panel ID="pnlHello" Visible="false" runat="server" Height="50px">
                    <h1>HELLO</h1>
                </asp:Panel>

                <asp:Panel ID="pnlBye" Visible="false" runat="server" Height="50px">>
                    <h1>BYE</h1>
                </asp:Panel>--%>

                <%--<div id="pnlHello" runat="server" style="display: none;">
                    <h1>HELLO</h1>
                </div>
                <div id="pnlBye" runat="server" style="display: none;">
                    <h1>BYE</h1>
                </div>--%>



                <%--<asp:ImageButton ImageUrl="~/Images/VCM/pnl1.png" runat="server"
                    OnClientClick="return ShowHellopanel();"
                    ToolTip="Add Vendor Details"
                    OnClick="Unnamed_Click"
                    Width="30px" Height="30px" />

                <asp:ImageButton ImageUrl="~/Images/VCM/pnl1.png" runat="server"
                    OnClientClick="return ShowHellopanel();"
                    ToolTip="Add Vendor Details"
                    OnClick="Unnamed_Click1"
                    Width="30px" Height="30px" />--%>


                <table width="50%">

                    <tr>
                        <td>&nbsp;</td>
                    </tr>
                    <tr>
                        <td></td>
                        <td>
                            <asp:ImageButton ImageUrl="~/Images/VCM/a_pnl1.png"
                                runat="server"
                                ID="imgBtnShowPnl1"
                                OnClientClick="ShowPanel(1); return false;"
                                ToolTip="Add Vendor Details"
                                Width="30px" Height="30px" />
                        </td>
                        <td>&nbsp;</td>
                        <td>
                            <asp:ImageButton ImageUrl="~/Images/VCM/pnl2.png"
                                runat="server"
                                ID="imgBtnShowPnl2"
                                OnClientClick="ShowPanel(2); return false;"
                                ToolTip="Add Billing Address"
                                Width="30px" Height="30px" />
                        </td>
                        <td>&nbsp;</td>
                        <td>
                            <asp:ImageButton ImageUrl="~/Images/VCM/pnl3.png"
                                runat="server"
                                ID="imgBtnShowPnl3"
                                OnClientClick="ShowPanel(3); return false;"
                                ToolTip="Add Contact Person"
                                Width="30px" Height="30px" />
                        </td>
                        <td>&nbsp;</td>
                        <td>
                            <asp:ImageButton ImageUrl="~/Images/VCM/pnl4.png"
                                runat="server"
                                ID="imgBtnShowPnl4"
                                OnClientClick="ShowPanel(4); return false;"
                                ToolTip="Add Bank Detail"
                                Width="30px" Height="30px" />
                        </td>
                        <td>&nbsp;</td>
                        <td>
                            <asp:ImageButton ImageUrl="~/Images/VCM/pnl5.png"
                                runat="server"
                                ID="imgBtnShowPnl5"
                                OnClientClick="ShowPanel(5); return false;"
                                ToolTip="Add Vendor Other Details"
                                Width="30px" Height="30px" />
                        </td>
                        <td>&nbsp;</td>
                        <td>
                            <asp:ImageButton ImageUrl="~/Images/VCM/pnl6.png"
                                runat="server"
                                ID="imgBtnShowPnl6"
                                OnClientClick="ShowPanel(6); return false;"
                                ToolTip="Add Attachments"
                                Width="30px" Height="30px" />
                        </td>
                    </tr>
                </table>


                <asp:Panel ID="pnlVendorDetails" runat="server" Style="display: block;">

                    <table width="80%">

                        <tr>
                            <td>&nbsp;</td>
                        </tr>

                        <tr>
                            <td colspan="2" align="center">
                                <h4><u>Vendor Details</u></h4>
                            </td>
                        </tr>
                        <tr>
                            <td>&nbsp;</td>
                        </tr>
                        <tr>
                            <td style="width: 30%;">Name:</td>
                            <td colspan="4">

                                <table width="100%">
                                    <tr>
                                        <td style="width: 70%">
                                            <asp:TextBox ID="txtName" runat="server" Width="100%" />
                                        </td>

                                        <td style="width: 30%">
                                            <asp:TextBox ID="txtCode" runat="server" Width="100%" Enabled="false" />
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td>&nbsp;</td>
                        </tr>
                        <tr>
                            <td style="width: 30%;">PAN Number:</td>
