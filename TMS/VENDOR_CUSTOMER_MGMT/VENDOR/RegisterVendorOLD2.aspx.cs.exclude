                dr["DOC"] = FileBytesOther2;
                dr["IS_DELETED"] = 0;
                dr["IS_REVISED"] = 0;
                dtTemp.Rows.Add(dr);
            }

            if (!string.IsNullOrEmpty(Convert.ToString(FileNameOther3)) && FileBytesOther3 != null)
            {
                DataRow dr = dtTemp.NewRow();
                dr["SR_NO"] = 7;
                dr["PID"] = 0;
