                                <asp:TextBox ID="txtBranchToS" runat="server" Width="100%" />
                            </td>
                            <td>&nbsp;</td>
                            <td style="width: 15%;">SWIFT Code:</td>
                            <td style="width: 30%">
                                <asp:TextBox ID="txtSWIFTCodeToS" runat="server" Width="100%" />
                            </td>
                        </tr>
                        <tr>
                            <td>&nbsp;</td>
                        </tr>
                        <tr>
                            <td style="width: 15%;">Account Number:</td>
                            <td style="width: 30%">
                                <asp:TextBox ID="txtAccountNumberToS" runat="server" Width="100%" />
                            </td>
                            <td>&nbsp;</td>
                            <td style="width: 15%;">RTGS/IFSC:</td>
                            <td style="width: 30%">
                                <asp:TextBox ID="txtRTGSOrIFSCToS" runat="server" Width="100%" />
