                            <td style="width: 30%;">
                                <asp:FileUpload ID="fileUploadAttachmentOther2" runat="server" Width="100%" Height="29px" BorderStyle="Groove" />
                            </td>
                        </tr>
                        <tr>
                            <td style="width: 15%;"></td>
                            <td style="width: 30%;">
                                <div id="divfileAttachmentOther1" style="display: none;">
                                    <asp:Label ID="lblfileAttachmentOther1" runat="server" ForeColor="Red" />
                                </div>
                            </td>
                            <td>&nbsp;</td>
                            <td style="width: 15%;"></td>
                            <td style="width: 30%;">
                                <div id="divfileAttachmentOther2" style="display: none;">
                                    <asp:Label ID="lblfileAttachmentOther2" runat="server" ForeColor="Red" />
                                </div>
                            </td>
                        </tr>


                        <tr>
                            <td style="width: 15%;">Other 3:</td>
                            <td style="width: 30%;">
                                <asp:FileUpload ID="fileUploadAttachmentOther3" runat="server" Width="100%" Height="29px" BorderStyle="Groove" />
                            </td>
                            <td>&nbsp;</td>
                            <td style="width: 15%;">Other 4:</td>
                            <td style="width: 30%;">
                                <asp:FileUpload ID="fileUploadAttachmentOther4" runat="server" Width="100%" Height="29px" BorderStyle="Groove" />
                            </td>
                        </tr>
                        <tr>
                            <td style="width: 15%;"></td>
                            <td style="width: 30%;">
                                <div id="divfileAttachmentOther3" style="display: none;">
                                    <asp:Label ID="lblfileAttachmentOther3" runat="server" ForeColor="Red" />
                                </div>
                            </td>
                            <td>&nbsp;</td>
                            <td style="width: 15%;"></td>
                            <td style="width: 30%;">
                                <div id="divfileAttachmentOther4" style="display: none;">
                                    <asp:Label ID="lblfileAttachmentOther4" runat="server" ForeColor="Red" />
                                </div>
                            </td>
                        </tr>

                        <tr>
                            <td>&nbsp;</td>
                        </tr>
                    </table>

                </fieldset>

                <br />
                <fieldset style="width: 90%;">
                    <legend style="text-align: center; font-size: 15px;"><i>Saving</i></legend>

                    <table width="90%">
                        <tr>
                            <td>&nbsp;</td>

                        </tr>
                        <tr>
                            <td style="width: 15%;">Remarks:</td>
                            <td>
                                <asp:TextBox ID="txtRemarksToS" runat="server" Width="100%" Rows="3" TextMode="MultiLine" />
                            </td>
                        </tr>
                        <tr>
                            <td>&nbsp;</td>

                        </tr>
                        <tr>
                            <td style="width: 15%;">Saving Type:</td>
                            <td>
                                <asp:RadioButtonList ID="rdSavingType" runat="server" RepeatDirection="Horizontal" Width="50%">
                                    <asp:ListItem Text="Save for later" Value="0" Selected="True" />
                                    <asp:ListItem Text="Save & send for approval" Value="1" />
                                </asp:RadioButtonList>
                            </td>
                        </tr>
                        <tr>
                            <td>&nbsp;</td>

                        </tr>
                    </table>

                </fieldset>

            </div>
            <table>
                <tr>
                    <td>&nbsp;</td>
                </tr>
                <tr>
                    <td>
                        <asp:Button ID="btnSave" runat="server" Width="100%" Text="Save" CssClass="button"
                            OnClick="btnSave_Click" OnClientClick="return ValidateAll();" />
                    </td>
                </tr>

                <tr>
                    <td>&nbsp;</td>
                </tr>

                <tr>
                    <td>&nbsp;</td>
                    <td align="center">
                        <asp:Panel ID="pnlMsg" Visible="false" runat="server" Height="50px">
                            <asp:Label ID="lblMsg" runat="server" Font-Bold="True" Font-Size="Large" />
                        </asp:Panel>
                    </td>
                </tr>
            </table>
        </fieldset>
    </div>

    <%--</ContentTemplate>
    </asp:UpdatePanel>--%>



    <%--ADD BILLING ADDRESS START--%>
    <asp:Button ID="btnShowPopupAddBillingAddress" runat="server" Style="display: none" />
    <ajax:ModalPopupExtender ID="mpeAddBillingAddress" runat="server" TargetControlID="btnShowPopupAddBillingAddress"
        PopupControlID="pnlPopupAddBillingAddress" CancelControlID="imgBtnCancelAddBillingAddress" BackgroundCssClass="modalBackground">
    </ajax:ModalPopupExtender>
    <asp:Panel ID="pnlPopupAddBillingAddress" runat="server" BackColor="White" Height="650px" Width="900px"
        Style="display: block; border-radius: 10px; padding: 20px;">
        <table width="100%">
            <tr>
                <td align="right">
                    <asp:ImageButton ID="imgBtnCancelAddBillingAddress" ImageUrl="~/Images/cancelled_img.png" runat="server" />
                </td>
            </tr>
        </table>

        <div align="center">

            <fieldset style="width: 90%; margin-left: 0px; margin-top: 10px;">
                <legend style="text-align: center;">Billing Address</legend>
                <asp:HiddenField ID="HiddenField1" runat="server" />
                <asp:HiddenField ID="HiddenField2" runat="server" />
                <asp:HiddenField ID="HiddenField3" runat="server" />
                <div style="width: 100%; margin-left: 0px;">

                    <table width="90%">
                        <tr>
                            <td>&nbsp;</td>
                        </tr>
                        <tr>
                            <td style="width: 15%;">Address Line 1:</td>
                            <td colspan="4">
                                <asp:TextBox ID="txtAddress1ToS" runat="server" Width="100%" />
                            </td>
                        </tr>
                        <tr>
                            <td>&nbsp;</td>
                        </tr>
                        <tr>
                            <td style="width: 15%;">Address Line 2:</td>
                            <td colspan="4">
                                <asp:TextBox ID="txtAddress2ToS" runat="server" Width="100%" />
                            </td>
                        </tr>
                        <tr>
                            <td>&nbsp;</td>
                        </tr>
                        <tr>
                            <td style="width: 15%;">Address Line 3:</td>
                            <td colspan="4">
                                <asp:TextBox ID="txtAddress3ToS" runat="server" Width="100%" />
                            </td>
                        </tr>
                        <tr>
                            <td>&nbsp;</td>
                        </tr>

                        <tr>

                            <td style="width: 15%;">State:</td>
                            <td style="width: 30%">
                                <asp:DropDownList ID="ddlStateToS" runat="server" Width="100%" Height="26px"
                                    onchange="GenerateGSTIN();">
                                </asp:DropDownList>
                            </td>
                            <td>&nbsp;</td>
                            <td style="width: 15%;">Other State:</td>
                            <td style="width: 30%">
                                <asp:TextBox ID="txtOtherStateToS" runat="server" Width="100%" Enabled="false" />
                            </td>
                        </tr>
                        <tr>
                            <td>&nbsp;</td>
                        </tr>
                        <tr>
                            <td style="width: 15%;">City:</td>
                            <td style="width: 30%">
                                <asp:TextBox ID="txtCityToS" runat="server" Width="100%" />
                            </td>
                            <td>&nbsp;</td>
                            <td style="width: 15%;">PIN Code:</td>
                            <td style="width: 30%">
                                <asp:TextBox ID="txtPINCodeToS" runat="server" Width="100%" />
                            </td>
                        </tr>
                        <tr>
                            <td>&nbsp;</td>
                        </tr>
                        <tr>
                            <td style="width: 15%;">Phone:</td>
                            <td style="width: 30%">
                                <asp:TextBox ID="txtPhoneToS" runat="server" Width="100%"
                                    onkeypress="return inNumberKeyWithDecimal(this, event);" />
                            </td>
                            <td>&nbsp;</td>
                            <td style="width: 15%;">Email:</td>
                            <td style="width: 30%">
                                <asp:TextBox ID="txtEmailToS" runat="server" Width="100%" />
                            </td>
                        </tr>
                        <tr>
                            <td>&nbsp;</td>
                        </tr>

                        <tr>

                            <td style="width: 15%;">PAN:</td>
                            <td style="width: 30%;">
                                <asp:TextBox ID="txtPANToSS" runat="server" Width="100%" ReadOnly="true" />
                            </td>
                            <td>&nbsp;</td>

                            <td style="width: 15%;">GSTIn Running No.:</td>
                            <td style="width: 30%;">
                                <asp:TextBox ID="txtGSTInRunningNoToS" runat="server" Width="100%" onkeyup="GenerateGSTIN();" />
                            </td>


                        </tr>
                        <tr>
                            <td>&nbsp;</td>
                        </tr>
                        <tr>
                            <td style="width: 15%;">GSTIn:</td>
                            <td style="width: 30%;">
                                <asp:TextBox ID="txtGSTInToS" runat="server" Width="100%" />
                            </td>
                            <td>&nbsp;</td>
                            <td style="width: 15%;">Is Default?:</td>
                            <td style="width: 30%">
                                <asp:CheckBox ID="chkIsDefaultBillingAddressToS" runat="server" />
                            </td>
                        </tr>
                        <tr>
                            <td>&nbsp;</td>
                        </tr>
                        <tr>
                            <td colspan="5">
                                <div align="center">
                                    <asp:Label ID="lblBillingAddressWindowMsg" runat="server" ForeColor="Red" />
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td colspan="5">
                                <asp:Button ID="btnAddUpdateAddressToList" CssClass="button" runat="server" Text="Add Address"
                                    Width="100%" OnClick="btnAddUpdateAddressToList_Click"
                                    OnClientClick="return ValidateBillingAddress();" /></td>
                        </tr>

                    </table>



                </div>
            </fieldset>

        </div>
    </asp:Panel>
    <%--ADD BILLING ADDRESS END--%>


    <%--ADD CONTACT PERSON START--%>
    <asp:Button ID="btnShowPopupAddContactPerson" runat="server" Style="display: none" />
    <ajax:ModalPopupExtender ID="mpeAddContactPerson" runat="server" TargetControlID="btnShowPopupAddContactPerson"
        PopupControlID="pnlPopupAddContactPerson" CancelControlID="imgBtnCancelAddContactPerson" BackgroundCssClass="modalBackground">
    </ajax:ModalPopupExtender>
    <asp:Panel ID="pnlPopupAddContactPerson" runat="server" BackColor="White" Height="340px" Width="900px"
        Style="display: block; border-radius: 10px; padding: 20px;">
        <table width="100%">
            <tr>
                <td align="right">
                    <asp:ImageButton ID="imgBtnCancelAddContactPerson" ImageUrl="~/Images/cancelled_img.png" runat="server" />
                </td>
            </tr>
        </table>

        <div align="center">

            <fieldset style="width: 90%; margin-left: 0px; margin-top: 10px;">
                <legend style="text-align: center;">Add Contact Person</legend>
                <asp:HiddenField ID="HiddenField4" runat="server" />
                <asp:HiddenField ID="HiddenField5" runat="server" />
                <asp:HiddenField ID="HiddenField6" runat="server" />
                <div style="width: 100%; margin-left: 0px;">

                    <table width="750px">
                        <tr>
                            <td style="width: 15%;">Name:</td>
                            <td colspan="4">
                                <asp:TextBox ID="txtContactPersonNameToS" runat="server" Width="100%" />
                            </td>
                        </tr>
                        <tr>
                            <td>&nbsp;</td>
                        </tr>

                        <tr>
                            <td style="width: 15%;">Mobile:</td>
                            <td style="width: 30%">
                                <asp:TextBox ID="txtContactPersonMobileToS" runat="server" Width="100%"
                                    onkeypress="return inNumberKeyWithDecimal(this, event);" />
                            </td>
                            <td>&nbsp;</td>
                            <td style="width: 15%;">Phone:</td>
                            <td style="width: 30%">
                                <asp:TextBox ID="txtContactPersonPhoneToS" runat="server" Width="100%"
                                    onkeypress="return inNumberKeyWithDecimal(this, event);" />
                            </td>
                        </tr>
                        <tr>
                            <td>&nbsp;</td>
                        </tr>
                        <tr>
                            <td style="width: 15%;">Email:</td>
                            <td style="width: 30%">
                                <asp:TextBox ID="txtContactPersonEmailToS" runat="server" Width="100%" />
                            </td>
                            <td>&nbsp;</td>
                            <td style="width: 15%;">Is Default?:</td>
                            <td style="width: 30%">
                                <asp:CheckBox ID="chkIsDefaultContactPersonToS" runat="server" />

                            </td>
                        </tr>

                        <tr>
                            <td>&nbsp;</td>
                        </tr>
                        <tr>
                            <td colspan="5">
                                <asp:Button ID="btnAddUpdateContactPersonToList" CssClass="button" runat="server" Text="Add Contact Person"
                                    Width="100%" OnClick="btnAddUpdateContactPersonToList_Click"
                                    OnClientClick="return ValidateContactPerson();" /></td>
                        </tr>
                    </table>
                </div>
            </fieldset>

        </div>

    </asp:Panel>
    <%--ADD CONTACT PERSON END--%>


    <%--ADD BANK DETAILS START--%>
    <asp:Button ID="btnShowPopupAddBankDetails" runat="server" Style="display: none" />
    <ajax:ModalPopupExtender ID="mpeAddBankDetails" runat="server" TargetControlID="btnShowPopupAddBankDetails"
        PopupControlID="pnlPopupAddBankDetails" CancelControlID="imgBtnCancelAddBankDetails" BackgroundCssClass="modalBackground">
