                            , lblFileNameGSTIN.Text
                            , lblFileNamePAN.Text
                            , lblFileNameCC.Text
                            , lblFileNameOther1.Text
                            , lblFileNameOther2.Text
                            , lblFileNameOther3.Text
                            , lblFileNameOther4.Text);

                        //ddlStateToS.Enabled = false;
                    }

                    else if (Convert.ToString(e.CommandArgument) == "APPROVE_AL1")
                    {
                        btnUpdateStatus.Visible = true;
                        btnUpdateStatus.Text = "Approve Vendor";
                        nextStatusId = (int)StatusAndTypes.EnumStatus.FinanceLevel1Approved_5;
                        ViewState["NEXT_STATUS_ID"] = nextStatusId;

                        ShowAttachedFiles(
                              lblPIDVRF.Text
                            , lblPIDGSTIN.Text
                            , lblPIDPAN.Text
                            , lblPIDCC.Text
