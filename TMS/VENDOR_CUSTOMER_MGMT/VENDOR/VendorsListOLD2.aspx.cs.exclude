                        btnUpdateStatus.Text = "Amend Vendor";
                        nextStatusId = (int)StatusAndTypes.EnumStatus.Amended_3;
                        ViewState["NEXT_STATUS_ID"] = nextStatusId;

                        //pnlAddAttachments.Visible = true;

                        if (Convert.ToInt32(lblAddressCount.Text) > 1)
