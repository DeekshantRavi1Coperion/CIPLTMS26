                            , lblPIDOther3.Text
                            , lblPIDOther4.Text
                            , lblFileNameVRF.Text
                            , lblFileNameGSTIN.Text
                            , lblFileNamePAN.Text
                            , lblFileNameCC.Text
                            , lblFileNameOther1.Text
                            , lblFileNameOther2.Text
                            , lblFileNameOther3.Text
                            , lblFileNameOther4.Text);

                        //ddlStateToS.Enabled = false;
                    }

                    else if (Convert.ToString(e.CommandArgument) == "APPROVE_AL2")
                    {
                        btnUpdateStatus.Visible = true;
                        btnUpdateStatus.Text = "Approve Vendor";
                        nextStatusId = (int)StatusAndTypes.EnumStatus.FinanceLevel2Approved_6;
                        ViewState["NEXT_STATUS_ID"] = nextStatusId;

                        ShowAttachedFiles(
                              lblPIDVRF.Text
                            , lblPIDGSTIN.Text
                            , lblPIDPAN.Text
                            , lblPIDCC.Text
                            , lblPIDOther1.Text
                            , lblPIDOther2.Text
                            , lblPIDOther3.Text
                            , lblPIDOther4.Text
                            , lblFileNameVRF.Text
                            , lblFileNameGSTIN.Text
                            , lblFileNamePAN.Text
                            , lblFileNameCC.Text
                            , lblFileNameOther1.Text
                            , lblFileNameOther2.Text
                            , lblFileNameOther3.Text
                            , lblFileNameOther4.Text);

                        //ddlStateToS.Enabled = false;
                    }

                    else if (Convert.ToString(e.CommandArgument) == "REGISTER")
                    {
                        txtCodeToS.Enabled = true;
                        btnRegisterVendor.Visible = true;
                        btnRegisterVendor.Text = "Register Vendor";

                        if (Convert.ToInt32(lblRevisedBy.Text) > 0)
                        {
                            btnRegisterVendor.Text = "Register Revised Vendor";
                        }

                        nextStatusId = (int)StatusAndTypes.EnumStatus.Registered_7;
                        ViewState["NEXT_STATUS_ID"] = nextStatusId;

                        ShowAttachedFiles(
                              lblPIDVRF.Text
                            , lblPIDGSTIN.Text
