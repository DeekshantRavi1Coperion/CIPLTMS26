                                </td>
                            </tr>
                        </table>
                    </td>

                    <td>&nbsp;</td>

                    <td align="right">Vendor Name:</td>
                    <td>
                        <asp:TextBox ID="txtVendorNameS" runat="server" Width="100%" />
                    </td>

                    <td>&nbsp;</td>
                    <td align="right">Vendor Code:</td>
